---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Doodle from '../../components/Doodle.astro';
import { person } from '../../data/site';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---
<Base title="Writing" description="Book reviews and notes on building software.">
  <section class="wrap page">
    <h1 class="display echo">Reading pile</h1>
    <p class="intro">Book reviews and notes on building software, written slowly.</p>

    {posts.length === 0 ? (
      <div class="empty">
        <Doodle name="book" class="empty-art" />
        <div>
          <p>Nothing published yet. The first review is in progress.</p>
          <p><a href={person.linkedin}>Follow me on LinkedIn</a> to catch it when it goes up.</p>
        </div>
      </div>
    ) : (
      <ul class="list">
        {posts.map((p) => (
          <li>
            <p class="meta">{fmt(p.data.date)}{p.data.kind === 'review' && p.data.book && `. Review of ${p.data.book.title} by ${p.data.book.author}`}</p>
            <a class="display" href={`/writing/${p.id}/`}>{p.data.title}</a>
            <p>{p.data.summary}</p>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>

<style>
  .page { padding-top: clamp(8rem, 14vw, 10rem); padding-bottom: 6rem; min-height: 70svh; }
  h1 { font-size: clamp(4.5rem, 12vw, 9rem); }
  .intro { color: var(--chalk); margin: 1rem 0 3rem; }
  .empty { display: flex; gap: 1.6rem; align-items: center; color: var(--chalk); }
  .empty :global(.empty-art) { width: 120px; flex: none; }
  .empty p { margin: 0 0 0.4rem; }
  .list { list-style: none; margin: 0; padding: 0; max-width: 760px; }
  .list li { padding-block: 1.6rem; border-top: 1px solid rgb(var(--chalk-rgb) / 0.18); }
  .list .display { font-size: clamp(2.2rem, 5vw, 3.2rem); text-decoration: none; }
  .list .display:hover { text-decoration: underline; }
  .meta { margin: 0 0 0.3rem; color: var(--paper-dim); font-size: var(--s-16); }
  .list p:last-child { margin: 0.4rem 0 0; color: var(--chalk); }
</style>
