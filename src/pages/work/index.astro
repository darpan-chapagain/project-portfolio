---
// Projects, laid out like the experience section of a printed resume:
// employer by employer, newest first, every line opening its case file.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Doodle from '../../components/Doodle.astro';
import Sky from '../../components/Sky.astro';
import { person, roles } from '../../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const byId = (id: string) => projects.find((p) => p.id === id)!;

const groups = [
  { id: 'all', label: 'All' },
  { id: 'fintech', label: 'Fintech' },
  { id: 'platforms', label: 'Platforms' },
  { id: 'ai', label: 'AI and vision' },
  { id: 'games', label: 'Games and systems' },
] as const;
const count = (g: string) => (g === 'all' ? projects.length : projects.filter((p) => p.data.group === g).length);
const industry = projects.filter((p) => p.data.kind === 'professional').length;

// The doodle beside each employer matches its level on the journey page.
const art: Record<string, string> = {
  'AMNIL Technologies': 'dial',
  'F1Soft International': 'vault',
  'Proshore (Digital Product Labs)': 'laptop',
};

type Block = { company: string; titles: string; when: string[]; place: string; art: string; ids: string[] };
const fromRoles: Block[] = roles.map((r) => ({
  company: r.company,
  titles: r.titles.join(' and '),
  when: [r.start, `to ${r.end}`],
  place: r.place,
  art: art[r.company] ?? 'star',
  ids: r.projects,
}));
const claimed = new Set(roles.flatMap((r) => r.projects));

const sections = [
  {
    title: 'Industry',
    blocks: [
      ...fromRoles,
      {
        company: 'Hivelaya',
        titles: byId('learning-management-and-job-matching-platform').data.role,
        when: ['Side project'],
        place: 'Nepal',
        art: 'cap',
        ids: ['learning-management-and-job-matching-platform'],
      },
    ],
  },
  {
    title: 'Independent',
    blocks: [
      {
        company: 'On my own',
        titles: 'Built solo and at Wright State University',
        when: ['2025 to now'],
        place: 'Fairborn, Ohio',
        art: 'biplane',
        ids: projects.filter((p) => p.data.kind !== 'professional' && !claimed.has(p.id)).map((p) => p.id),
      },
    ],
  },
];

// Resume bullets: the results, or the key technical details when a project has no numbers yet.
function bullets(p: (typeof projects)[number]) {
  if (p.data.results.length) return p.data.results.slice(0, 3);
  const m = (p.body ?? '').match(/## Key Technical Details\n([\s\S]*?)(\n## |$)/);
  return m ? m[1].split('\n').filter((l) => l.startsWith('- ')).map((l) => l.slice(2)).slice(0, 2) : [];
}

const same = (a: string, b: string) => a.replace(/&/g, 'and').toLowerCase() === b.replace(/&/g, 'and').toLowerCase();
const entryName = (p: (typeof projects)[number], company: string) =>
  p.data.short === company ? sentence(p.data.title.replace(/\s*\(.*\)$/, '').replace(/ & /g, ' and ')) : p.data.short;
function sentence(t: string) { return t.charAt(0) + t.slice(1).toLowerCase(); }

let n = 0;
---
<Base title="Projects" description="Banking platforms, compliance automation, on-device AI and a 2D game: what I've shipped and built, with how each one works.">
  <section class="head has-sky">
    <Sky
      roomy
      items={[
        { art: 'stupa', x: 60, y: 70, w: 74, depth: 0.5, speed: 0.03 },
        { art: 'laptop', x: 71, y: 36, w: 80, depth: 0.8, rot: -6 },
        { art: 'vault', x: 82, y: 72, w: 70, depth: 0.6, speed: -0.03, rot: 5 },
        { art: 'biplane', x: 91, y: 28, w: 96, depth: 1.1, rot: -8 },
      ]}
      stars={[{ x: 66, y: 16 }, { x: 96, y: 60 }, { x: 77, y: 90 }]}
    />
    <div class="wrap">
      <h1 class="display echo">Projects</h1>
      <p class="intro">
        {projects.length} things I've shipped or built, set out like my resume: {industry} in industry, {projects.length - industry} on my own.
        Open any line for the problem, how it was built and what changed.
      </p>

      <div class="filters" role="toolbar" aria-label="Filter projects">
        {groups.map((g, i) => (
          <button type="button" class:list={['chip', { on: i === 0 }]} data-filter={g.id} aria-pressed={i === 0 ? 'true' : 'false'}>
            {g.label} <span class="n">{count(g.id)}</span>
            <svg class="squiggle" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true"><path d="M2 6 C18 1 30 9 46 5 S78 2 98 6" pathLength="1" /></svg>
          </button>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap list-wrap" aria-label="All projects">
    <article class="sheet" data-reveal>
      <header class="mast">
        <p class="name display">{person.name}</p>
        <ul class="contact">
          <li>{person.location}</li>
          <li><a href={`mailto:${person.email}`}>{person.email}</a></li>
          <li><a href={person.linkedin}>LinkedIn</a></li>
          <li><a href={person.github}>GitHub</a></li>
        </ul>
      </header>

      {sections.map((s) => (
        <section class="part" data-part aria-labelledby={`part-${s.title}`}>
          <h2 id={`part-${s.title}`} class="part-title display">{s.title}</h2>
          {s.blocks.map((b, bi) => (
            <div class:list={['block', { first: bi === 0 }]} data-block style={`--b:${n++}`}>
              <div class="margin">
                <Doodle name={b.art} class:list={["block-art", `art-${b.art}`]} />
                <p class="when hand">{b.when.map((w, i) => <>{i > 0 && <br />}{w}</>)}</p>
                <p class="place">{b.place}</p>
              </div>
              <div class="main">
                <h3 class="company display">{b.company}</h3>
                <p class="titles">{b.titles}</p>
                <ol class="entries">
                  {b.ids.map((id, ei) => {
                    const p = byId(id);
                    return (
                      <li class:list={['entry', { first: ei === 0 }]} data-group={p.data.group}>
                        <div class="entry-head">
                          <h4 class="entry-title">
                            <a class="stretch" href={`/work/${p.id}/`}>{entryName(p, b.company)}</a>
                            {p.data.client && <span class="client">for {p.data.client}</span>}
                          </h4>
                          {p.data.apps.length > 0 && <p class="live hand">{p.data.apps.length} apps live on Shopify</p>}
                          {!same(p.data.role, b.titles) && <p class="role">{p.data.role}</p>}
                        </div>
                        <ul class="points">
                          {bullets(p).map((t) => <li>{t}</li>)}
                        </ul>
                        <div class="entry-foot">
                          <p class="stack">{p.data.stack.slice(0, 5).join(', ')}{p.data.stack.length > 5 && ' and more'}</p>
                          <p class="open hand" aria-hidden="true">open the file <Doodle name="arrow" class="open-arrow" /></p>
                        </div>
                      </li>
                    );
                  })}
                </ol>
              </div>
            </div>
          ))}
        </section>
      ))}
    </article>
  </section>
</Base>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'));
  const parts = Array.from(document.querySelectorAll<HTMLElement>('[data-part]'));
  const blocks = Array.from(document.querySelectorAll<HTMLElement>('[data-block]'));
  const entries = Array.from(document.querySelectorAll<HTMLElement>('.entry'));
  const ease = 'cubic-bezier(0.2, 0.7, 0.2, 1)';

  // Filter the resume. Employers that stay glide to their new place, lines that stay
  // glide inside their employer, and lines that come back fade in.
  function apply(group: string) {
    const rect = (el: HTMLElement) => el.getBoundingClientRect();
    const blockBefore = new Map(blocks.filter((b) => !b.hidden).map((b) => [b, rect(b)]));
    const entryBefore = new Map(
      entries.filter((e) => !e.hidden).map((e) => {
        const b = e.closest<HTMLElement>('[data-block]')!;
        return [e, rect(e).top - rect(b).top];
      })
    );

    entries.forEach((e) => { e.hidden = !(group === 'all' || e.dataset.group === group); });
    blocks.forEach((b) => { b.hidden = !b.querySelector('.entry:not([hidden])'); });
    parts.forEach((p) => { p.hidden = !p.querySelector('[data-block]:not([hidden])'); });
    // Rules only go between lines that are actually showing.
    const markFirst = (els: HTMLElement[]) => els.forEach((el, i) => el.classList.toggle('first', i === 0));
    parts.forEach((p) => markFirst(Array.from(p.querySelectorAll<HTMLElement>('[data-block]:not([hidden])'))));
    blocks.forEach((b) => markFirst(Array.from(b.querySelectorAll<HTMLElement>('.entry:not([hidden])'))));

    if (reduce) return;
    let k = 0;
    blocks.forEach((b) => {
      if (b.hidden) return;
      const before = blockBefore.get(b);
      if (before) {
        const dy = before.top - rect(b).top;
        if (dy) b.animate([{ translate: `0 ${dy}px` }, { translate: '0 0' }], { duration: 560, easing: ease });
      } else {
        b.animate([{ opacity: 0, translate: '0 18px' }, { opacity: 1, translate: '0 0' }], { duration: 480, delay: k++ * 70, easing: ease, fill: 'backwards' });
      }
    });
    entries.forEach((e) => {
      if (e.hidden) return;
      const b = e.closest<HTMLElement>('[data-block]')!;
      if (!blockBefore.has(b)) return;
      const before = entryBefore.get(e);
      if (before === undefined) {
        e.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 420, delay: 120, easing: ease, fill: 'backwards' });
        return;
      }
      const dy = before - (rect(e).top - rect(b).top);
      if (dy) e.animate([{ translate: `0 ${dy}px` }, { translate: '0 0' }], { duration: 560, easing: ease });
    });
    window.dispatchEvent(new Event('resize'));
  }

  chips.forEach((chip) => chip.addEventListener('click', () => {
    if (chip.classList.contains('on')) return;
    chips.forEach((c) => { c.classList.toggle('on', c === chip); c.setAttribute('aria-pressed', String(c === chip)); });
    apply(chip.dataset.filter || 'all');
  }));
</script>

<style>
  .head { padding: clamp(8rem, 14vw, 10rem) 0 2.5rem; }
  h1 { font-size: clamp(5rem, 15vw, 11rem); }
  .intro { max-width: 52ch; color: var(--chalk); margin: 1rem 0 2.2rem; }

  .filters { display: flex; flex-wrap: wrap; gap: 0.4rem 1.6rem; }
  .chip {
    position: relative;
    padding: 0.3rem 0 0.7rem;
    border: 0;
    background: none;
    color: var(--paper-dim);
    font: inherit;
    font-size: var(--s-16);
    cursor: pointer;
    transition: color 250ms ease;
  }
  .chip .n { font-family: var(--hand); font-size: 0.95em; margin-left: 0.15rem; opacity: 0.8; }
  .chip:hover, .chip.on { color: var(--paper); }
  .squiggle {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 9px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 450ms var(--ease);
  }
  .chip.on .squiggle { stroke-dashoffset: 0; }

  .list-wrap { padding-bottom: 6rem; }

  /* One printed sheet. It stays paper-coloured in both themes, like a resume on a desk. */
  .sheet {
    position: relative;
    margin-top: 1.5rem;
    padding: clamp(1.5rem, 4.5vw, 3.75rem) clamp(1.25rem, 5vw, 4.25rem) clamp(2rem, 5vw, 4rem);
    background: var(--card);
    color: var(--card-ink);
    border-radius: 2px;
    box-shadow: 0 1px 0 rgb(0 0 0 / 0.05), 0 40px 70px -40px var(--shadow-soft), 0 12px 24px -16px var(--shadow);
  }
  .sheet a { color: inherit; }

  .mast {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem 2rem;
    padding-bottom: 1rem;
    /* A resume's double rule: one heavy, one hairline. */
    border-bottom: 3px solid var(--card-ink);
    box-shadow: 0 5px 0 -4px var(--card-ink);
  }
  .name { margin: 0; font-size: clamp(2.6rem, 5.4vw, 4.25rem); line-height: 0.9; }
  .contact { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.3rem 1.4rem; font-size: var(--s-14); color: rgb(var(--card-ink-rgb) / 0.72); }
  .contact a { text-decoration: none; border-bottom: 1px dashed rgb(var(--card-ink-rgb) / 0.4); }
  .contact a:hover { border-bottom-style: solid; color: var(--card-ink); }

  .part { margin-top: clamp(2rem, 4vw, 2.8rem); }
  .part[hidden], .block[hidden], .entry[hidden] { display: none; }
  .part-title {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0;
    font-size: var(--s-24);
    letter-spacing: 0.08em;
  }
  .part-title::after { content: ''; flex: 1; border-top: 1px solid rgb(var(--card-ink-rgb) / 0.35); }

  .block {
    display: grid;
    grid-template-columns: minmax(120px, 160px) minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding-block: 1.7rem 0.4rem;
  }
  .block:not(.first) { border-top: 1px solid rgb(var(--card-ink-rgb) / 0.14); margin-top: 1.1rem; }

  .margin { padding-top: 0.2rem; }
  .margin :global(.block-art) { width: 78px; color: var(--card-ink); opacity: 0.88; margin-bottom: 0.6rem; }
  .margin :global(.art-biplane) { width: 104px; }
  .when { margin: 0; font-size: var(--s-18); line-height: 1.25; }
  .place { margin: 0.15rem 0 0; font-size: var(--s-14); color: rgb(var(--card-ink-rgb) / 0.6); }

  .company { margin: 0; font-size: clamp(2rem, 3vw, 2.5rem); line-height: 0.95; }
  .titles { margin: 0.3rem 0 0; font-style: italic; color: rgb(var(--card-ink-rgb) / 0.78); }

  .entries { list-style: none; margin: 0.9rem 0 0; padding: 0; }
  .entry { position: relative; padding: 1rem 0 1.05rem; border-top: 1px dashed rgb(var(--card-ink-rgb) / 0.2); }
  .entry.first { border-top: 0; padding-top: 0.6rem; }

  .entry-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.2rem 1.5rem; }
  .entry-title { margin: 0; font-family: var(--text); font-size: var(--s-18); font-weight: 680; line-height: 1.3; }
  .entry-title a { text-decoration: none; background: linear-gradient(currentColor, currentColor) no-repeat 0 100% / 0 1.5px; transition: background-size 400ms var(--ease); }
  .client { margin-left: 0.5rem; font-weight: 400; font-style: italic; font-size: 0.85em; color: rgb(var(--card-ink-rgb) / 0.65); }
  .live { margin: 0; font-size: var(--s-16); line-height: 1.2; padding: 0 0.2em; background: linear-gradient(transparent 50%, rgb(236 217 111 / 0.85) 50%, rgb(236 217 111 / 0.85) 92%, transparent 92%); }
  .role { margin: 0; font-size: var(--s-14); font-style: italic; color: rgb(var(--card-ink-rgb) / 0.65); }
  /* The whole line opens the case file. */
  .stretch::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .stretch:focus-visible { outline: none; }
  .entry:has(.stretch:focus-visible) { outline: 2px solid var(--card-ink); outline-offset: 6px; border-radius: 2px; }

  .points { margin: 0.45rem 0 0; padding: 0; list-style: none; max-width: 70ch; font-size: var(--s-16); line-height: 1.5; }
  .points li { position: relative; padding-left: 1.15rem; }
  .points li + li { margin-top: 0.15rem; }
  .points li::before { content: ''; position: absolute; left: 0.1rem; top: 0.72em; width: 0.5rem; height: 1.5px; background: rgb(var(--card-ink-rgb) / 0.55); border-radius: 1px; }

  .entry-foot { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.2rem 1.5rem; margin-top: 0.5rem; }
  .stack { margin: 0; font-size: var(--s-14); color: rgb(var(--card-ink-rgb) / 0.6); }
  .open { display: inline-flex; align-items: center; gap: 0.4rem; margin: 0 0 0 auto; font-size: var(--s-16); color: rgb(var(--card-ink-rgb) / 0.55); transition: color 300ms var(--ease); }
  .open :global(.open-arrow) { width: 34px; transition: transform 400ms var(--ease); }

  .entry:hover .entry-title a { background-size: 100% 1.5px; }
  .entry:hover .open { color: var(--card-ink); }
  .entry:hover .open :global(.open-arrow) { transform: translateX(6px) rotate(-4deg); }

  /* The sheet comes up, then each employer is ruled in like the home page's Experience. */
  .js .sheet:not(.is-in) { opacity: 0; }
  .js .sheet:not(.is-in) .block { opacity: 0; }
  .sheet.is-in { animation: sheet-up 900ms var(--ease) backwards; }
  .sheet.is-in .block { animation: block-in 700ms var(--ease) backwards; animation-delay: calc(250ms + var(--b) * 110ms); }
  @keyframes sheet-up { from { opacity: 0; transform: translateY(40px); } to { opacity: 1; transform: none; } }
  @keyframes block-in { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }

  @media (max-width: 720px) {
    .block { grid-template-columns: 1fr; gap: 0.6rem; }
    .margin { display: grid; grid-template-columns: auto 1fr; align-items: center; column-gap: 0.9rem; }
    .margin :global(.block-art) { grid-row: span 2; width: 56px; margin: 0; }
    .entry-head { flex-direction: column; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet.is-in, .sheet.is-in .block { animation: none; }
    .js .sheet:not(.is-in), .js .sheet:not(.is-in) .block { opacity: 1; }
  }
</style>
