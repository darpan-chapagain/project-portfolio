---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Doodle from '../../components/Doodle.astro';
import Sky from '../../components/Sky.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const groups = [
  { id: 'all', label: 'All' },
  { id: 'fintech', label: 'Fintech' },
  { id: 'platforms', label: 'Platforms' },
  { id: 'ai', label: 'AI and vision' },
  { id: 'games', label: 'Games and systems' },
] as const;
const count = (g: string) => (g === 'all' ? projects.length : projects.filter((p) => p.data.group === g).length);
const label = (g: string) => groups.find((x) => x.id === g)?.label ?? g;
const industry = projects.filter((p) => p.data.kind === 'professional').length;
const tilt = [-0.6, 0.5, 0.3, -0.4, 0.6, -0.3];
---
<Base title="Projects" description="Banking platforms, compliance automation, on-device AI and a 2D game: what I've shipped and built, with how each one works.">
  <section class="head has-sky">
    <Sky
      roomy
      items={[
        { art: 'compass', x: 80, y: 30, w: 86, depth: 0.8, rot: 12 },
        { art: 'route', x: 66, y: 62, w: 92, depth: 0.5, speed: 0.04 },
      ]}
      stars={[{ x: 92, y: 18 }, { x: 74, y: 16 }, { x: 95, y: 70 }, { x: 58, y: 40 }]}
    />
    <div class="wrap">
      <h1 class="display echo">Projects</h1>
      <p class="intro">
        {projects.length} things I've shipped or built: {industry} in industry, {projects.length - industry} on my own.
        Open any file for the problem, how it was built and what changed.
      </p>

      <div class="filters" role="toolbar" aria-label="Filter projects">
        {groups.map((g, i) => (
          <button type="button" class:list={['chip', { on: i === 0 }]} data-filter={g.id} aria-pressed={i === 0 ? 'true' : 'false'}>
            {g.label} <span class="n">{count(g.id)}</span>
            <svg class="squiggle" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true"><path d="M2 6 C18 1 30 9 46 5 S78 2 98 6" pathLength="1" /></svg>
          </button>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap list-wrap" aria-label="All projects">
    <ul class="cases" data-reveal>
      {projects.map((p, i) => (
        <li class="case-wrap" data-group={p.data.group} style={`--i:${i % 6};--r:${tilt[i % tilt.length]}deg`}>
          <a class="case" href={`/work/${p.id}/`}>
            <span class="tab hand">{label(p.data.group)}</span>
            <span class="body">
              <span class="top">
                <span class="where">
                  {p.data.company ?? (p.data.kind === 'professional' ? 'Industry' : 'Independent')}
                  {p.data.client && <span class="client">for {p.data.client}</span>}
                </span>
                <Doodle name={p.data.art} class="case-art" />
              </span>
              <span class="title display">{p.data.short}</span>
              <span class="sum">{p.data.summary}</span>
              {p.data.results.length > 0 && (
                <span class="wins">
                  {p.data.results.slice(0, 2).map((r) => <span class="win">{r}</span>)}
                </span>
              )}
              <span class="foot">
                <span class="role">{p.data.role}</span>
                <span class="stack">{p.data.stack.slice(0, 4).join(', ')}{p.data.stack.length > 4 && ' and more'}</span>
              </span>
              <span class="open hand">open the file</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const list = document.querySelector<HTMLUListElement>('.cases');
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'));
  const items = Array.from(list?.querySelectorAll<HTMLElement>('.case-wrap') ?? []);

  // Filter with a FLIP animation: cards that stay glide to their new spot, new ones rise in.
  function apply(group: string) {
    const first = new Map(items.filter((el) => !el.hidden).map((el) => [el, el.getBoundingClientRect()]));
    items.forEach((el) => { el.hidden = !(group === 'all' || el.dataset.group === group); });
    if (!reduce) {
      let k = 0;
      items.forEach((el) => {
        if (el.hidden) return;
        const last = el.getBoundingClientRect();
        const f = first.get(el);
        if (f) {
          const dx = f.left - last.left, dy = f.top - last.top;
          if (dx || dy) el.animate([{ translate: `${dx}px ${dy}px` }, { translate: '0 0' }], { duration: 560, easing: 'cubic-bezier(0.2, 0.7, 0.2, 1)' });
        } else {
          el.animate(
            [{ opacity: 0, translate: '0 26px', scale: '0.97' }, { opacity: 1, translate: '0 0', scale: '1' }],
            { duration: 520, delay: 50 + k++ * 60, easing: 'cubic-bezier(0.2, 0.7, 0.2, 1)', fill: 'backwards' }
          );
        }
      });
    }
    window.dispatchEvent(new Event('resize'));
  }

  chips.forEach((chip) => chip.addEventListener('click', () => {
    if (chip.classList.contains('on')) return;
    chips.forEach((c) => { c.classList.toggle('on', c === chip); c.setAttribute('aria-pressed', String(c === chip)); });
    apply(chip.dataset.filter || 'all');
  }));

  // A gentle tilt toward the cursor, like picking up a sheet of paper.
  if (!reduce && window.matchMedia('(pointer: fine)').matches) {
    items.forEach((wrap) => {
      const card = wrap.querySelector<HTMLElement>('.case');
      if (!card) return;
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        card.style.setProperty('--ry', `${(x * 5).toFixed(2)}deg`);
        card.style.setProperty('--rx', `${(-y * 4).toFixed(2)}deg`);
      });
      card.addEventListener('pointerleave', () => {
        card.style.setProperty('--ry', '0deg');
        card.style.setProperty('--rx', '0deg');
      });
    });
  }
</script>

<style>
  .head { padding: clamp(8rem, 14vw, 10rem) 0 2.5rem; }
  h1 { font-size: clamp(5rem, 15vw, 11rem); }
  .intro { max-width: 52ch; color: var(--chalk); margin: 1rem 0 2.2rem; }

  .filters { display: flex; flex-wrap: wrap; gap: 0.4rem 1.6rem; }
  .chip {
    position: relative;
    padding: 0.3rem 0 0.7rem;
    border: 0;
    background: none;
    color: var(--paper-dim);
    font: inherit;
    font-size: var(--s-16);
    cursor: pointer;
    transition: color 250ms ease;
  }
  .chip .n { font-family: var(--hand); font-size: 0.95em; margin-left: 0.15rem; opacity: 0.8; }
  .chip:hover, .chip.on { color: var(--paper); }
  .squiggle {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 9px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 450ms var(--ease);
  }
  .chip.on .squiggle { stroke-dashoffset: 0; }

  .list-wrap { padding-bottom: 6rem; }
  .cases {
    list-style: none;
    margin: 0;
    padding: 1.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem 2.4rem;
  }
  .case-wrap { transform: rotate(var(--r)); }
  .case-wrap[hidden] { display: none; }
  .js .cases:not(.is-in) .case-wrap { opacity: 0; }
  .cases.is-in .case-wrap { animation: file-in 900ms cubic-bezier(0.25, 1.3, 0.5, 1) backwards; animation-delay: calc(var(--i) * 110ms); }
  @keyframes file-in {
    from { opacity: 0; transform: translateY(50px) rotate(calc(var(--r) - 4deg)); }
    to { opacity: 1; transform: rotate(var(--r)); }
  }

  /* A manila file: a tab on top, the sheet underneath. */
  .case {
    --rx: 0deg;
    --ry: 0deg;
    position: relative;
    display: block;
    padding-top: 1.9rem;
    color: var(--card-ink);
    text-decoration: none;
    transform: perspective(900px) rotateX(var(--rx)) rotateY(var(--ry));
    transition: transform 260ms var(--ease);
  }
  .tab {
    position: absolute;
    top: 0;
    left: 1.2rem;
    height: 2.05rem;
    padding: 0.25rem 1.1rem 0;
    background: color-mix(in srgb, var(--card) 86%, var(--card-ink));
    color: var(--card-ink);
    font-size: var(--s-16);
    border-radius: 6px 6px 0 0;
    clip-path: polygon(8% 0, 92% 0, 100% 100%, 0 100%);
  }
  .body {
    position: relative;
    display: grid;
    gap: 0.75rem;
    padding: 1.6rem 1.7rem 1.4rem;
    background: var(--card);
    border-radius: 2px 6px 4px 4px;
    box-shadow: 0 1px 0 rgb(var(--card-ink-rgb) / 0.08), 0 18px 30px -18px var(--shadow-soft);
    transition: box-shadow 300ms ease, translate 300ms var(--ease);
  }
  .case:hover .body, .case:focus-visible .body { translate: 0 -6px; box-shadow: 0 1px 0 rgb(var(--card-ink-rgb) / 0.08), 0 30px 40px -20px var(--shadow-soft); }
  .case:focus-visible { outline: none; }
  .case:focus-visible .body { outline: 2px dashed var(--accent); outline-offset: 4px; }

  .top { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; min-height: 64px; }
  .where { font-size: var(--s-14); color: rgb(var(--card-ink-rgb) / 0.7); display: grid; gap: 0.1rem; }
  .client { font-style: italic; }
  .top :global(.case-art) { width: 100px; flex: none; color: var(--card-ink); transition: transform 500ms var(--ease); }
  .case:hover :global(.case-art) { transform: rotate(-6deg) scale(1.08); }
  .title { font-size: clamp(2.3rem, 3.6vw, 3rem); line-height: 0.92; }
  .sum { font-size: var(--s-16); line-height: 1.5; color: rgb(var(--card-ink-rgb) / 0.82); max-width: 52ch; }
  .wins { display: grid; gap: 0.35rem; }
  .win { position: relative; padding-left: 1.4rem; font-style: italic; font-size: var(--s-16); line-height: 1.4; }
  .win::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 0.3em;
    width: 0.7rem;
    height: 0.4rem;
    border-left: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(-45deg);
  }
  .foot { display: grid; gap: 0.15rem; padding-top: 0.7rem; border-top: 1px solid rgb(var(--card-ink-rgb) / 0.15); font-size: var(--s-14); color: rgb(var(--card-ink-rgb) / 0.7); }
  .role { color: var(--card-ink); }
  .open { justify-self: end; font-size: var(--s-18); border-bottom: 1px dashed currentColor; line-height: 1.2; }

  @media (max-width: 820px) {
    .cases { grid-template-columns: 1fr; gap: 2.4rem; }
  }
</style>
