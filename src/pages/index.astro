---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import PlayRing from '../components/PlayRing.astro';
import ContactSheet from '../components/ContactSheet.astro';
import Doodle from '../components/Doodle.astro';
import Sky from '../components/Sky.astro';
import ProductBoard from '../components/ProductBoard.astro';
import Stubs from '../components/Stubs.astro';
import { person, roles, education, clients, selectedWork } from '../data/site';

// The home page is the trailer. Each section shows a little and links to the full version.
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = selectedWork.map((w) => projects.find((p) => p.id === w.id)!);
const lines = Object.fromEntries(selectedWork.map((w) => [w.id, w.line]));
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const masters = education[0];

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---
<Base>
  <Hero />

  <section id="experience" class="section career-sec has-sky" aria-labelledby="exp">
    <Sky
      items={[
        { art: 'card', x: 84, y: 88, w: 100, depth: 1, speed: -0.03, rot: -9 },
      ]}
      stars={[{ x: 92, y: 8 }, { x: 70, y: 94 }, { x: 4, y: 70 }]}
    />
    <div class="wrap">
      <div class="section-head" data-speed="-0.04">
        <h2 id="exp" class="display">Experience</h2>
        <p>Four years in software. Shopify apps for a US client first, then banking products for 16+ institutions in Kathmandu.</p>
      </div>
      <ol class="career" data-reveal>
        {roles.map((r, i) => (
          <li class="row" style={`--i:${i}`}>
            <p class="when">{r.start.split(' ')[1]} to {r.end.split(' ')[1]}</p>
            <div class="who">
              <h3><a class="stretch" href={`/work/#${slug(r.company)}`}>{r.company}</a></h3>
              <p class="titles">{r.titles.join(' and ')}</p>
            </div>
            <p class="headline" set:html={r.headline} />
          </li>
        ))}
      </ol>
      <p class="creds">{masters.degree}, {masters.school}. {education[1].degree}. IBM Product Manager certified.</p>
      <a class="all-link" href="/work/">
        <span class="hand">Full resume and all {projects.length} projects</span>
        <Doodle name="arrow" class="all-arrow" />
      </a>
    </div>
  </section>

  <section class="clients" aria-label="Banks and financial institutions I've shipped for">
    <p class="clients-label hand wrap">Shipped for</p>
    <div class="marquee">
      <ul class="track">
        {[0, 1].map((copy) => clients.map((c) => (
          <li aria-hidden={copy === 1 ? 'true' : undefined}><span class="display">{c}</span><Doodle name="star" class="sep" /></li>
        )))}
      </ul>
    </div>
  </section>

  <section class="section how wrap" aria-labelledby="how">
    <div class="section-head" data-speed="-0.04">
      <h2 id="how" class="display">How I build</h2>
      <p>One card from each column of my working board. Every card is a rule I picked up on a real product.</p>
    </div>
    <ProductBoard limit={1} />
    <a class="all-link" href="/how-i-build/">
      <span class="hand">See the whole board</span>
      <Doodle name="arrow" class="all-arrow" />
    </a>
  </section>

  <section id="work" class="section work" aria-labelledby="work-title">
    <div class="wrap">
      <div class="section-head" data-speed="-0.04">
        <h2 id="work-title" class="display">Selected work</h2>
        <p>Three of the {projects.length}: live apps used around the world, a banking migration and AI on a phone. Pick a frame to read how it was built.</p>
      </div>
      <ContactSheet items={featured} lines={lines} label="Selected projects" />
      <a class="all-link" href="/work/">
        <span class="hand">See all {projects.length} projects</span>
        <Doodle name="arrow" class="all-arrow" />
      </a>
    </div>
  </section>

  <section class="section wrap honours" aria-labelledby="honours-title">
    <div class="section-head" data-speed="-0.04">
      <h2 id="honours-title" class="display">Along the way</h2>
      <p>An award, a talk, some mentoring and a bit of community work.</p>
    </div>
    <Stubs />
  </section>

  <PlayRing compact />

  {posts.length > 0 && (
    <section class="section reading has-sky" aria-labelledby="reading-title">
      <Sky
        items={[
          { art: 'tea', x: 74, y: 58, w: 80, depth: 0.8 },
          { art: 'lamp', x: 90, y: 62, w: 54, depth: 0.5, speed: 0.04 },
        ]}
        stars={[{ x: 62, y: 76 }, { x: 84, y: 90 }, { x: 96, y: 46 }]}
      />
      <div class="wrap">
        <div class="section-head" data-speed="-0.04">
          <h2 id="reading-title" class="display">Reading pile</h2>
          <p>Book reviews and notes on building software.</p>
        </div>
        <ul class="post-list">
          {posts.map((p) => (
            <li>
              <a href={`/writing/${p.id}/`}>{p.data.title}</a>
              <p class="muted">{fmt(p.data.date)}{p.data.book && `. Review of ${p.data.book.title} by ${p.data.book.author}`}</p>
            </li>
          ))}
        </ul>
        <a class="all-link" href="/writing/">
          <span class="hand">Everything I've written</span>
          <Doodle name="arrow" class="all-arrow" />
        </a>
      </div>
    </section>
  )}

  <section id="contact" class="section contact has-sky" aria-labelledby="contact-title">
    <Sky
      items={[
        { art: 'envelope', x: 74, y: 13, w: 108, depth: 0.7, rot: 6 },
        { art: 'plane', x: 62, y: 50, w: 56, depth: 1.2, speed: -0.06, rot: -12 },
      ]}
      stars={[{ x: 90, y: 9 }, { x: 96, y: 44 }, { x: 57, y: 18 }, { x: 66, y: 88 }]}
    />
    <div class="wrap contact-inner">
      <h2 id="contact-title" class="display start echo">Press start</h2>
      <div class="contact-body">
        <p class="lede">Hiring a product manager, especially in fintech? Want to talk payments and banking, or trade book recommendations? Email is fastest.</p>
        <a class="email" href={`mailto:${person.email}`}>{person.email}</a>
        <p class="links"><a href={person.linkedin}>LinkedIn</a> <a href={person.github}>GitHub</a></p>
      </div>
      <p class="postit hand contact-note" style="--r:4deg" data-speed="-0.08">Based in Fairborn, Ohio. From Kathmandu. Looking for product management roles, ideally in fintech. Open to other good problems too.</p>
    </div>
  </section>
</Base>

<style>
  /* Experience as one line per company */
  .career-sec { padding-bottom: clamp(2.5rem, 6vw, 4rem); }
  .career { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid rgb(var(--chalk-rgb) / 0.2); }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 9rem minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 0.4rem 2rem;
    align-items: baseline;
    padding-block: 1.3rem;
    border-top: 1px solid rgb(var(--chalk-rgb) / 0.2);
  }
  .when { margin: 0; color: var(--paper-dim); font-size: var(--s-16); }
  .who h3 { margin: 0; font-family: var(--display); text-transform: uppercase; font-size: clamp(1.9rem, 3vw, 2.5rem); line-height: 1; }
  .who a { color: var(--paper); text-decoration: none; }
  .stretch::after { content: ''; position: absolute; inset: 0; }
  .titles { margin: 0.25rem 0 0; color: var(--paper-dim); font-size: var(--s-16); }
  .headline { margin: 0; color: var(--chalk); font-size: var(--s-16); }
  .headline :global(strong) { color: var(--paper); font-weight: 650; }
  .row:hover h3 a { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.12em; }
  .row:has(a:focus-visible) { outline: 2px solid var(--paper); outline-offset: 4px; }
  .js .career:not(.is-in) .row { opacity: 0; }
  .career.is-in .row { animation: rise 800ms var(--ease) backwards; animation-delay: calc(var(--i) * 140ms); }
  @keyframes rise { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
  .creds { margin: 1.3rem 0 0; color: var(--paper-dim); font-size: var(--s-16); max-width: 70ch; }

  /* Banks marquee */
  .clients { padding: 1.2rem 0 2.2rem; overflow: hidden; }
  .clients-label { margin: 0 auto 0.6rem; font-size: var(--s-21); color: var(--paper-dim); }
  .marquee {
    overflow: hidden;
    -webkit-mask: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .track { list-style: none; margin: 0; padding: 0; display: flex; width: max-content; animation: drift-x 45s linear infinite; }
  .marquee:hover .track { animation-play-state: paused; }
  .track li { display: flex; align-items: center; gap: 1.6rem; padding-right: 1.6rem; }
  .track .display { font-size: clamp(2.2rem, 4.4vw, 3.6rem); color: var(--paper); opacity: 0.85; white-space: nowrap; }
  .track :global(.sep) { width: 14px; color: var(--chalk-2); }
  @keyframes drift-x { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .js .career:not(.is-in) .row { opacity: 1; }
    .track { animation: none; flex-wrap: wrap; width: auto; padding-inline: var(--gutter); }
    .track li[aria-hidden='true'] { display: none; }
  }

  /* Work */
  .work { background: linear-gradient(var(--ink), var(--ink-2) 18%, var(--ink-2) 82%, var(--ink)); }
  .all-link {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 2rem;
    font-size: var(--s-24);
    text-decoration: none;
    color: var(--paper);
  }
  .all-link .hand { border-bottom: 1px dashed var(--chalk-2); line-height: 1.25; }
  .all-link :global(.all-arrow) { width: 64px; transition: transform 400ms var(--ease); }
  .all-link:hover :global(.all-arrow) { transform: translateX(8px) rotate(-4deg); }
  .all-link:hover .hand { border-bottom-color: var(--paper); }

  /* Reading */
  .muted { color: var(--paper-dim); font-size: var(--s-16); }
  .post-list { list-style: none; margin: 0; padding: 0; }
  .post-list li { padding-block: 1rem; border-top: 1px solid rgb(var(--chalk-rgb) / 0.18); }
  .post-list a { font-size: var(--s-24); }
  .post-list p { margin: 0.2rem 0 0; }

  /* Contact */
  .contact { border-top: 1px solid rgb(var(--chalk-rgb) / 0.14); }
  .contact-inner { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 1rem 3rem; align-items: end; position: relative; }
  .start { font-size: clamp(5rem, 15vw, 12rem); grid-column: 1 / -1; }
  .lede { margin: 0 0 1.2rem; max-width: 44ch; }
  .email { font-size: clamp(var(--s-21), 3vw, var(--s-36)); word-break: break-all; }
  .links { display: flex; gap: 1.5rem; margin: 1rem 0 0; color: var(--paper-dim); }
  .contact-note { max-width: 260px; justify-self: end; margin: 0; }

  @media (max-width: 760px) {
    .row { grid-template-columns: 1fr; gap: 0.25rem; }
    .contact-inner { grid-template-columns: 1fr; }
    .contact-note { justify-self: start; margin-top: 2rem; }
  }
</style>
