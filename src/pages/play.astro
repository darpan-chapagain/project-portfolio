---
// Play my journey: the game. Levels come from site.ts, the script from data/game.ts.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { levels, person } from '../data/site';
import { script, cast, sequel, type LevelScript } from '../data/game';

const projects = await getCollection('projects');
const titleOf = (id: string) => projects.find((p) => p.id === id)?.data.short ?? id;

// A level with no script still gets a street, a building and its card.
const fallback = (title: string): LevelScript => ({
  scene: 'city',
  length: 560,
  building: { type: 'office', at: 120, sign: title.toUpperCase().slice(0, 12) },
  skills: { from: 300, gap: 46 },
});

const playable = levels.map((l) => ({
  id: l.id,
  n: l.n,
  title: l.title,
  script: script[l.id] ?? fallback(l.title),
  skills: l.unlocked ?? [],
}));
const next = levels.length + 1;
const data = { levels: playable, cast, sequel: { n: next, poster: sequel.poster } };
---
<Base title="Play my journey" description="A small pixel game of my journey so far, from Kathmandu to Fairborn, Ohio.">
  <section class="play wrap" aria-labelledby="play-title">
    <h1 id="play-title" class="sr-only">Play my journey</h1>
    <div class="stage" data-game>
      <canvas width="320" height="180" tabindex="0" aria-label="Game: walk from Kathmandu to Fairborn. The story of each level is also in the chapter cards."></canvas>

      <div class="hud" aria-live="polite">
        <p class="hud-level hand" data-hud-level>Level 1</p>
        <p class="hud-right hand">
          <span data-hud-extra hidden></span>
          <span data-hud-skills>Skills 0</span>
          <button type="button" class="fs" data-fullscreen aria-label="Full screen" title="Full screen">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 6V2h4M10 2h4v4M14 10v4h-4M6 14H2v-4" /></svg>
          </button>
        </p>
      </div>

      <div class="bubbles" data-bubbles></div>
      <p class="caption" data-caption hidden></p>
      <p class="toast hand" data-toast role="status" hidden></p>
      <button type="button" class="jump hand" data-jump aria-label="Jump">jump</button>

      <div class="start" data-start>
        <div class="sheet">
          <p class="kicker hand">Level 1 of {levels.length}</p>
          <h2 class="display">Play my journey</h2>
          <p>From Kathmandu to Fairborn, one level at a time.</p>
          <dl class="controls">
            <div><dt class="hand">Keyboard</dt><dd>Arrow keys or A and D to walk. Space to jump. E to go inside.</dd></div>
            <div><dt class="hand">Mouse or touch</dt><dd>Tap where you want to go. Tap high to jump. Tap a door to go inside, or a boss to take it on.</dd></div>
          </dl>
          <button type="button" class="go" data-begin>Start</button>
          <p class="alt">Rather read? <a href="/journey/">See the storyboard</a>.</p>
        </div>
      </div>

      <div class="cards" data-cards hidden>
        {levels.map((l) => {
          const s = script[l.id];
          const words = s?.card ?? l.story;
          return (
            <article class="card" data-card={l.id} role="dialog" aria-modal="true" aria-labelledby={`card-${l.id}`} hidden>
              <p class="kicker hand">Level {l.n}</p>
              <h2 id={`card-${l.id}`} class="display">{l.title}</h2>
              <p class="meta">{l.when}. {l.place}.</p>
              {words.map((w) => <p>{w}</p>)}
              {l.boss && <p class="boss"><span class="hand">Boss fight:</span> {l.boss}</p>}
              {l.unlocked && l.unlocked.length > 0 && <p class="unlocked"><span class="hand">Unlocked:</span> {l.unlocked.join(', ')}</p>}
              {l.projects && l.projects.length > 0 && (
                <ul class="links">{l.projects.map((id) => <li><a href={`/work/${id}/`}>{titleOf(id)}</a></li>)}</ul>
              )}
              <button type="button" class="go" data-close>Keep going</button>
            </article>
          );
        })}
        <article class="card" data-card="next" role="dialog" aria-modal="true" aria-labelledby="card-next" hidden>
          <p class="kicker hand">Level {next}</p>
          <h2 id="card-next" class="display">The sequel</h2>
          {sequel.card.map((w) => <p>{w}</p>)}
          <p class="contact"><a href={`mailto:${person.email}`}>{person.email}</a> <a href={person.linkedin}>LinkedIn</a></p>
          <div class="row">
            <button type="button" class="go" data-replay>Play again</button>
            <a class="ghost" href="/journey/">Read the storyboard</a>
            <button type="button" class="ghost" data-close>Close</button>
          </div>
        </article>
      </div>
    </div>
    <p class="turn hand">Turn your phone sideways for a bigger view.</p>
    <p class="below">Rather read it? <a href="/journey/">The journey as a storyboard</a>.</p>
  </section>
  <script type="application/json" id="game-data" set:html={JSON.stringify(data)} />
</Base>

<script>
  import { startGame } from '../game/engine';
  const root = document.querySelector<HTMLElement>('[data-game]');
  const raw = document.getElementById('game-data')?.textContent;
  if (root && raw) {
    startGame(root, JSON.parse(raw));
    const fsBtn = root.querySelector<HTMLButtonElement>('[data-fullscreen]');
    if (!document.fullscreenEnabled) fsBtn?.remove();
    fsBtn?.addEventListener('click', () => {
      if (document.fullscreenElement) document.exitFullscreen();
      else root.requestFullscreen().then(() => {
        const o = screen.orientation as ScreenOrientation & { lock?: (o: string) => Promise<void> };
        o.lock?.('landscape').catch(() => {});
      }).catch(() => {});
    });
  }
</script>

<style>
  .play { padding-top: clamp(5.5rem, 9vw, 6.5rem); padding-bottom: 3rem; }
  .stage {
    position: relative;
    width: min(100%, calc((100svh - 9.5rem) * 16 / 9));
    aspect-ratio: 16 / 9;
    margin: 0 auto;
    overflow: hidden;
    border: 1.5px solid rgb(var(--chalk-rgb) / 0.28);
    border-radius: 8px;
    background: var(--ink);
    container-type: inline-size;
  }
  .stage:fullscreen { width: 100vw; height: 100vh; max-width: none; border: 0; border-radius: 0; display: grid; place-items: center; }
  .stage:fullscreen canvas { width: min(100vw, calc(100vh * 16 / 9)); height: auto; aspect-ratio: 16 / 9; }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
    touch-action: none;
    cursor: pointer;
  }
  canvas:focus-visible { outline: 2px solid var(--paper); outline-offset: -4px; }

  .hud { position: absolute; inset: 0.4rem 0.7rem auto; display: flex; justify-content: space-between; align-items: center; gap: 1rem; pointer-events: none; }
  .hud p { margin: 0; color: var(--paper); font-size: clamp(0.8rem, 2.1cqi, 1.15rem); line-height: 1.2; }
  .hud-right { display: flex; align-items: center; gap: 0.9rem; }
  .hud-right [data-hud-extra] { padding: 0 0.3em; background: var(--postit); color: var(--postit-ink); }
  .fs { pointer-events: auto; display: grid; place-items: center; width: 1.8rem; height: 1.8rem; padding: 0; border: 1.5px solid rgb(var(--chalk-rgb) / 0.4); border-radius: 6px; background: var(--ink); color: var(--paper); cursor: pointer; }
  .fs svg { width: 0.9rem; fill: none; stroke: currentColor; stroke-width: 1.6; }

  /* Speech bubbles sit over the canvas and follow whoever is talking. */
  .bubbles { position: absolute; inset: 0; pointer-events: none; }
  .bubbles :global(.bubble) {
    position: absolute;
    translate: -50% -100%;
    max-width: min(46%, 18rem);
    width: max-content;
    padding: 0.3rem 0.6rem 0.35rem;
    background: var(--card);
    color: var(--card-ink);
    border: 1.5px solid var(--card-ink);
    border-radius: 10px;
    font-family: var(--hand);
    font-size: clamp(0.72rem, 2cqi, 1.05rem);
    line-height: 1.25;
    box-shadow: 0 6px 10px -6px var(--shadow);
    animation: bubble-in 260ms cubic-bezier(0.3, 1.5, 0.5, 1) backwards;
  }
  .bubbles :global(.bubble)::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -7px;
    width: 10px;
    height: 10px;
    translate: -50% 0;
    rotate: 45deg;
    background: var(--card);
    border-right: 1.5px solid var(--card-ink);
    border-bottom: 1.5px solid var(--card-ink);
  }
  .bubbles :global(.thought) { border-style: dashed; border-radius: 16px; font-style: italic; }
  .bubbles :global(.thought)::after { width: 6px; height: 6px; bottom: -9px; rotate: 0deg; border: 1.5px solid var(--card-ink); border-radius: 50%; }
  .bubbles :global(.who) { display: block; font-weight: 700; font-size: 0.82em; }
  .bubbles :global(.who small) { margin-left: 0.35rem; font-weight: 400; opacity: 0.62; font-size: 0.92em; }
  @keyframes bubble-in { from { opacity: 0; scale: 0.8; } to { opacity: 1; scale: 1; } }

  .caption {
    position: absolute;
    left: 50%;
    top: 18%;
    translate: -50% 0;
    margin: 0;
    max-width: 80%;
    padding: 0.4rem 0.9rem;
    background: var(--card);
    color: var(--card-ink);
    border: 1.5px solid var(--card-ink);
    font-style: italic;
    font-size: clamp(0.8rem, 2.2cqi, 1.15rem);
    text-align: center;
    animation: bubble-in 400ms var(--ease) backwards;
  }
  .toast {
    position: absolute;
    right: 0.8rem;
    top: 2.4rem;
    margin: 0;
    max-width: 50%;
    padding: 0.25rem 0.6rem;
    background: var(--postit);
    color: var(--postit-ink);
    font-size: clamp(0.75rem, 2cqi, 1.05rem);
    rotate: -1.5deg;
    box-shadow: 0 6px 10px -6px var(--shadow);
  }
  .toast:global(.pop) { animation: toast-in 380ms cubic-bezier(0.3, 1.5, 0.5, 1); }
  @keyframes toast-in { from { opacity: 0; translate: 0 -10px; } to { opacity: 1; translate: 0 0; } }

  .jump {
    display: none;
    position: absolute;
    right: 0.9rem;
    bottom: 0.9rem;
    width: 3.6rem;
    height: 3.6rem;
    border-radius: 50%;
    border: 1.5px solid var(--card-ink);
    background: var(--card);
    color: var(--card-ink);
    font-size: 1rem;
    opacity: 0.85;
    touch-action: none;
  }
  @media (pointer: coarse) { .jump { display: block; width: clamp(2.4rem, 9cqi, 3.6rem); height: clamp(2.4rem, 9cqi, 3.6rem); font-size: clamp(0.75rem, 2.4cqi, 1rem); } }
  /* Phones on their side: give the game every pixel under the top bar. */
  @media (max-height: 520px) {
    .play { padding-top: 4.2rem; padding-bottom: 1rem; padding-inline: 0.75rem; }
    .stage { width: min(100%, calc((100svh - 5rem) * 16 / 9)); }
    .below { display: none; }
  }

  /* Start screen and chapter cards: paper sheets over the game. */
  .start, .cards { position: absolute; inset: 0; display: grid; place-items: center; padding: 1rem; background: rgb(var(--ink-rgb) / 0.55); }
  .start[hidden], .cards[hidden] { display: none; }
  .sheet, .card {
    width: min(100%, 34rem);
    max-height: 100%;
    overflow: auto;
    padding: clamp(1rem, 3cqi, 1.8rem) clamp(1.1rem, 3.4cqi, 2rem);
    background: var(--card);
    color: var(--card-ink);
    box-shadow: 0 20px 40px -20px var(--shadow-soft);
    font-size: clamp(0.85rem, 1.9cqi, 1rem);
    animation: sheet-in 380ms cubic-bezier(0.3, 1.3, 0.5, 1) backwards;
  }
  .card[hidden] { display: none; }
  @keyframes sheet-in { from { opacity: 0; translate: 0 16px; rotate: -1deg; } to { opacity: 1; translate: 0 0; rotate: 0deg; } }
  .sheet h2, .card h2 { margin: 0 0 0.5rem; font-size: clamp(2rem, 6cqi, 3rem); line-height: 0.95; }
  .kicker { margin: 0 0 0.2rem; font-size: 1.05em; opacity: 0.7; }
  .meta { margin: 0 0 0.8rem; opacity: 0.7; font-size: 0.92em; }
  .card p, .sheet p { margin: 0 0 0.7rem; line-height: 1.5; }
  .card a, .sheet a { color: inherit; }
  .boss .hand, .unlocked .hand { color: #8a6b0f; font-size: 1.08em; }
  .links { margin: 0 0 1rem; padding-left: 1.1rem; }
  .links li + li { margin-top: 0.2rem; }
  .controls { margin: 0.8rem 0 1.1rem; display: grid; gap: 0.5rem; }
  .controls div { display: grid; grid-template-columns: 7.5rem 1fr; gap: 0.6rem; }
  .controls dt { font-size: 1.05em; }
  .controls dd { margin: 0; }
  .go, .ghost {
    display: inline-block;
    padding: 0.45rem 1.1rem;
    border: 1.5px solid var(--card-ink);
    border-radius: 999px;
    background: var(--card-ink);
    color: var(--card);
    font: inherit;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
  }
  .ghost { background: transparent; color: var(--card-ink); }
  .go:hover { opacity: 0.88; }
  .row { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; }
  .contact { display: flex; gap: 1.2rem; flex-wrap: wrap; }
  .alt { margin-top: 0.9rem !important; font-size: 0.92em; opacity: 0.8; }

  .below { margin: 1rem auto 0; text-align: center; color: var(--paper-dim); font-size: var(--s-14); }
  .below a { color: var(--paper); }
  .turn { display: none; margin: 0.8rem 0 0; text-align: center; color: var(--paper-dim); }
  @media (pointer: coarse) and (orientation: portrait) { .turn { display: block; } }

  /* On small screens the cards get the whole window, not just the game. */
  @media (max-width: 760px), (max-height: 520px) {
    .cards, .start { position: fixed; z-index: 60; padding: 0.8rem; }
    .sheet, .card { max-height: calc(100svh - 1.6rem); }
  }
  @media (prefers-reduced-motion: reduce) {
    .bubbles :global(.bubble), .sheet, .card, .caption, .toast:global(.pop) { animation: none; }
  }
</style>
