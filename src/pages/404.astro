---
import Base from '../layouts/Base.astro';
import Doodle from '../components/Doodle.astro';
---
<Base title="Page not found">
  <section class="wrap lost">
    <Doodle name="plane" class="lost-art" />
    <h1 class="display">Off the map</h1>
    <p>This page doesn't exist, or it moved. The home page has everything else.</p>
    <p><a href="/">Go to the home page</a></p>
  </section>
</Base>

<style>
  .lost { padding-top: 10rem; padding-bottom: 8rem; min-height: 75svh; }
  .lost :global(.lost-art) { width: 120px; color: var(--chalk); margin-bottom: 1.5rem; transform: rotate(-12deg); }
  h1 { font-size: clamp(4.5rem, 12vw, 9rem); margin-bottom: 1rem; }
  p { color: var(--chalk); }
</style>
