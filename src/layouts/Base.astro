---
import '../styles/global.css';
import { person } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = person.description } = Astro.props;
const fullTitle = title ? `${title} | ${person.name}` : `${person.name} | Technical product manager`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
// Two groups open a small menu; the label itself still goes to the main page of the group.
type Link = { href: string; label: string };
const nav: (Link & { items?: Link[] })[] = [
  { href: '/work/', label: 'Work', items: [{ href: '/work/', label: 'Projects and resume' }, { href: '/how-i-build/', label: 'How I build' }] },
  { href: '/journey/', label: 'Journey', items: [{ href: '/journey/', label: 'The storyboard' }, { href: '/play/', label: 'Play the game' }] },
  { href: '/writing/', label: 'Writing' },
  { href: '/#contact', label: 'Contact' },
];
const here = (href: string) => href.length > 2 && !href.includes('#') && path.startsWith(href);
const inGroup = (n: (typeof nav)[number]) => (n.items ?? [n]).some((i) => here(i.href));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ece5d5" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      // Pick the theme before anything paints.
      // A saved choice wins, then the tab's name (private modes that block storage).
      // Everyone else starts on light; the toggle switches to dark and remembers it.
      (function () {
        var d = document.documentElement, t;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') { var m = /(?:^|;)theme=(light|dark)/.exec(window.name || ''); if (m) t = m[1]; }
        if (t !== 'light' && t !== 'dark') t = 'light';
        if (t === 'dark') { var mc = document.querySelector('meta[name="theme-color"]'); if (mc) mc.setAttribute('content', '#15130f'); }
        d.dataset.theme = t;
        d.classList.add('js');
        // Low-end devices and data savers get a lighter page: no wobbling paper or ink.
        var cores = navigator.hardwareConcurrency || 8, mem = navigator.deviceMemory || 8;
        var save = navigator.connection && navigator.connection.saveData;
        if (cores <= 2 || mem <= 2 || save) d.classList.add('lite');
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <svg class="filters" width="0" height="0" aria-hidden="true" focusable="false">
      <defs>
        {[3, 17, 41].map((seed, i) => (
          <filter id={`boil-${i}`} x="-10%" y="-10%" width="120%" height="120%">
            <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="2" seed={seed} />
            <feDisplacementMap in="SourceGraphic" scale="2.4" />
          </filter>
        ))}
      </defs>
    </svg>
    <header class="topbar">
      <a class="mark display" href="/" aria-label={`${person.name}, home`}>DC</a>
      <nav aria-label="Main">
        <ul class="top">
          {nav.map((n, i) => n.items ? (
            <li class:list={['group', { current: inGroup(n) }]} data-group>
              <a class="top-link" href={n.href} aria-current={inGroup(n) ? 'true' : undefined}>{n.label}</a>
              <button class="caret" type="button" aria-expanded="false" aria-controls={`menu-${i}`} aria-label={`More in ${n.label}`}>
                <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" /></svg>
              </button>
              <ul class="menu" id={`menu-${i}`}>
                {n.items.map((it) => (
                  <li><a href={it.href} aria-current={path === it.href ? 'page' : undefined}>{it.label}</a></li>
                ))}
              </ul>
            </li>
          ) : (
            <li><a class="top-link" href={n.href} aria-current={here(n.href) ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
      </nav>
      <button class="theme-toggle" type="button" aria-label="Switch theme" title="Switch theme">
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" />
          <path d="M12 2.5v2.6M12 18.9v2.6M2.5 12h2.6M18.9 12h2.6M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" />
        </svg>
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M19.5 14.8A8 8 0 0 1 9.2 4.5a8 8 0 1 0 10.3 10.3Z" />
        </svg>
      </button>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot wrap">
      <p class="copy">© {person.name}</p>
      <p>
        <a href={person.github}>GitHub</a>
        <a href={person.linkedin}>LinkedIn</a>
        <a href={`mailto:${person.email}`}>Email</a>
      </p>
    </footer>

    <script>
      import '../scripts/motion.ts';

      // Nav menus: the arrow opens and closes its menu. Escape or a click elsewhere closes it.
      const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-group]'));
      const close = (g: HTMLElement) => { g.classList.remove('open'); g.querySelector('.caret')?.setAttribute('aria-expanded', 'false'); };
      groups.forEach((g) => {
        const btn = g.querySelector<HTMLButtonElement>('.caret');
        btn?.addEventListener('click', (e) => {
          e.stopPropagation();
          const open = !g.classList.contains('open');
          groups.forEach(close);
          if (open) { g.classList.add('open'); btn.setAttribute('aria-expanded', 'true'); }
        });
        g.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && g.classList.contains('open')) { close(g); btn?.focus(); }
        });
        g.addEventListener('focusout', (e) => {
          if (!g.contains(e.relatedTarget as Node)) close(g);
        });
      });
      document.addEventListener('click', (e) => {
        groups.forEach((g) => { if (!g.contains(e.target as Node)) close(g); });
      });
    </script>
  </body>
</html>

<style>
  .filters { position: absolute; width: 0; height: 0; overflow: hidden; }
  /* Sticky, and see-through until you scroll. Then it settles onto a soft ink bar. */
  .topbar {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem var(--gutter);
    border-bottom: 1px solid transparent;
    transition: padding 400ms var(--ease), background-color 400ms ease, border-color 400ms ease;
  }
  .topbar.scrolled {
    padding-block: 0.6rem;
    background-color: rgb(var(--ink-rgb) / 0.8);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border-bottom-color: rgb(var(--chalk-rgb) / 0.1);
  }
  .mark {
    font-size: 2.1rem;
    text-decoration: none;
    border: 1px solid var(--chalk-2);
    padding: 0.2rem 0.45rem 0;
    line-height: 1;
    transition: font-size 400ms var(--ease);
  }
  .topbar.scrolled .mark { font-size: 1.65rem; }
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    margin-left: clamp(0.6rem, 2vw, 1.4rem);
    padding: 0;
    border: 1px solid rgb(var(--chalk-rgb) / 0.35);
    border-radius: 50%;
    background: transparent;
    color: var(--paper);
    cursor: pointer;
    transition: border-color 300ms ease, transform 500ms var(--ease);
  }
  .theme-toggle:hover { border-color: var(--paper); transform: rotate(-20deg); }
  .theme-toggle svg { grid-area: 1 / 1; width: 1.1rem; height: 1.1rem; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; transition: opacity 300ms ease, transform 500ms var(--ease); }
  /* Show the sun in the dark (switch to day), the moon in the day. */
  :global([data-theme='light']) .theme-toggle .sun, :global([data-theme='dark']) .theme-toggle .moon { opacity: 0; transform: rotate(-90deg) scale(0.6); }
  nav { margin-left: auto; }
  .top { display: flex; align-items: center; gap: clamp(0.9rem, 3vw, 2rem); list-style: none; margin: 0; padding: 0; }
  .top-link { text-decoration: none; font-size: var(--s-16); color: var(--paper-dim); }
  .top-link:hover, .top-link[aria-current] { color: var(--paper); text-decoration: underline; }

  /* A group: the label link, a small arrow, and a menu that drops below. */
  .group { position: relative; display: flex; align-items: center; }
  .caret {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    margin-left: 0.05rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--paper-dim);
    cursor: pointer;
  }
  .caret svg { width: 0.75rem; height: 0.75rem; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; transition: transform 250ms var(--ease); }
  .caret:hover, .group.current .caret { color: var(--paper); }
  .menu {
    position: absolute;
    top: calc(100% + 0.45rem);
    left: -0.9rem;
    z-index: 2;
    min-width: 12.5rem;
    margin: 0;
    padding: 0.45rem;
    list-style: none;
    background: var(--ink-2);
    border: 1px solid rgb(var(--chalk-rgb) / 0.22);
    border-radius: 8px;
    box-shadow: 0 18px 30px -18px var(--shadow-soft);
    opacity: 0;
    visibility: hidden;
    translate: 0 -4px;
    transition: opacity 180ms ease, translate 220ms var(--ease), visibility 0s linear 220ms;
  }
  /* A bridge over the gap, so the menu stays open while the mouse moves down to it. */
  .menu::before { content: ''; position: absolute; inset: -0.6rem 0 auto 0; height: 0.6rem; }
  .menu a { display: block; padding: 0.55rem 0.7rem; border-radius: 5px; text-decoration: none; font-size: var(--s-16); color: var(--paper-dim); white-space: nowrap; }
  .menu a:hover, .menu a:focus-visible { background: rgb(var(--chalk-rgb) / 0.1); color: var(--paper); }
  .menu a[aria-current='page'] { color: var(--paper); text-decoration: underline; }
  .group.open .menu { opacity: 1; visibility: visible; translate: 0 0; transition: opacity 180ms ease, translate 220ms var(--ease); }
  .group.open .caret svg { transform: rotate(180deg); }
  @media (hover: hover) and (pointer: fine) {
    .group:hover .menu { opacity: 1; visibility: visible; translate: 0 0; transition: opacity 180ms ease, translate 220ms var(--ease); }
  }
  .foot {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-block: 2.5rem 3rem;
    position: relative;
    color: var(--graphite);
    font-size: var(--s-14);
  }
  .foot::before { content: ''; position: absolute; top: 0; left: var(--gutter); right: var(--gutter); border-top: 1px solid rgb(var(--chalk-rgb) / 0.18); }
  .foot p { margin: 0; display: flex; gap: 1.25rem; flex-wrap: wrap; }
  .foot a { color: var(--paper-dim); }
  @media (max-width: 520px) {
    .top { gap: 0.55rem; }
    .caret { width: 1.35rem; margin-left: 0; }
    .theme-toggle { width: 1.9rem; height: 1.9rem; margin-left: 0.6rem; }
    .top-link, .menu a { font-size: var(--s-14); }
    .menu { left: 50%; translate: -50% -4px; min-width: 11rem; }
    .group.open .menu { translate: -50% 0; }
  }
  @media (max-width: 360px) {
    .topbar { padding-inline: 0.8rem; }
    .top { gap: 0.35rem; }
    .caret { width: 1.1rem; }
    .top-link { font-size: 0.8rem; }
    .theme-toggle { margin-left: 0.35rem; }
    .mark { font-size: 1.45rem; }
    .mark { font-size: 1.7rem; }
    .topbar.scrolled .mark { font-size: 1.45rem; }
  }
</style>
