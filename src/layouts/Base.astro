---
import '../styles/global.css';
import { person } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = person.description } = Astro.props;
const fullTitle = title ? `${title} | ${person.name}` : `${person.name} | Technical product manager`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const nav = [
  { href: '/work/', label: 'Work' },
  { href: '/journey/', label: 'Journey' },
  { href: '/writing/', label: 'Writing' },
  { href: '/#contact', label: 'Contact' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#15130f" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ece5d5" media="(prefers-color-scheme: light)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      // Pick the theme before anything paints.
      // A saved choice wins, then the tab's name (private modes that block storage),
      // then the device setting: light unless the device is dark.
      (function () {
        var d = document.documentElement, t;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') { var m = /(?:^|;)theme=(light|dark)/.exec(window.name || ''); if (m) t = m[1]; }
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        d.dataset.theme = t;
        d.classList.add('js');
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <svg class="filters" width="0" height="0" aria-hidden="true" focusable="false">
      <defs>
        {[3, 17, 41].map((seed, i) => (
          <filter id={`boil-${i}`} x="-10%" y="-10%" width="120%" height="120%">
            <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="2" seed={seed} />
            <feDisplacementMap in="SourceGraphic" scale="2.4" />
          </filter>
        ))}
      </defs>
    </svg>
    <header class="topbar">
      <a class="mark display" href="/" aria-label={`${person.name}, home`}>DC</a>
      <nav aria-label="Main">
        <ul>
          {nav.map((n) => (
            <li><a href={n.href} aria-current={path.startsWith(n.href) && n.href.length > 2 ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
      </nav>
      <button class="theme-toggle" type="button" aria-label="Switch theme" title="Switch theme">
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" />
          <path d="M12 2.5v2.6M12 18.9v2.6M2.5 12h2.6M18.9 12h2.6M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" />
        </svg>
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M19.5 14.8A8 8 0 0 1 9.2 4.5a8 8 0 1 0 10.3 10.3Z" />
        </svg>
      </button>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot wrap">
      <p class="copy">© {new Date().getFullYear()} {person.name}. Built with Astro, hosted on Cloudflare.</p>
      <p>
        <a href={person.github}>GitHub</a>
        <a href={person.linkedin}>LinkedIn</a>
        <a href={`mailto:${person.email}`}>Email</a>
      </p>
    </footer>

    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>

<style>
  .filters { position: absolute; width: 0; height: 0; overflow: hidden; }
  /* Sticky, and see-through until you scroll. Then it settles onto a soft ink bar. */
  .topbar {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem var(--gutter);
    border-bottom: 1px solid transparent;
    transition: padding 400ms var(--ease), background-color 400ms ease, border-color 400ms ease;
  }
  .topbar.scrolled {
    padding-block: 0.6rem;
    background-color: rgb(var(--ink-rgb) / 0.8);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border-bottom-color: rgb(var(--chalk-rgb) / 0.1);
  }
  .mark {
    font-size: 2.1rem;
    text-decoration: none;
    border: 1px solid var(--chalk-2);
    padding: 0.2rem 0.45rem 0;
    line-height: 1;
    transition: font-size 400ms var(--ease);
  }
  .topbar.scrolled .mark { font-size: 1.65rem; }
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    margin-left: clamp(0.6rem, 2vw, 1.4rem);
    padding: 0;
    border: 1px solid rgb(var(--chalk-rgb) / 0.35);
    border-radius: 50%;
    background: transparent;
    color: var(--paper);
    cursor: pointer;
    transition: border-color 300ms ease, transform 500ms var(--ease);
  }
  .theme-toggle:hover { border-color: var(--paper); transform: rotate(-20deg); }
  .theme-toggle svg { grid-area: 1 / 1; width: 1.1rem; height: 1.1rem; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; transition: opacity 300ms ease, transform 500ms var(--ease); }
  /* Show the sun in the dark (switch to day), the moon in the day. */
  :global([data-theme='light']) .theme-toggle .sun, :global([data-theme='dark']) .theme-toggle .moon { opacity: 0; transform: rotate(-90deg) scale(0.6); }
  nav { margin-left: auto; }
  nav ul { display: flex; gap: clamp(0.9rem, 3vw, 2rem); list-style: none; margin: 0; padding: 0; }
  nav a { text-decoration: none; font-size: var(--s-16); color: var(--paper-dim); }
  nav a:hover, nav a[aria-current='page'] { color: var(--paper); text-decoration: underline; }
  .foot {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-block: 2.5rem 3rem;
    position: relative;
    color: var(--graphite);
    font-size: var(--s-14);
  }
  .foot::before { content: ''; position: absolute; top: 0; left: var(--gutter); right: var(--gutter); border-top: 1px solid rgb(var(--chalk-rgb) / 0.18); }
  .foot p { margin: 0; display: flex; gap: 1.25rem; flex-wrap: wrap; }
  .foot a { color: var(--paper-dim); }
  @media (max-width: 520px) {
    nav ul { gap: 0.7rem; }
    .theme-toggle { width: 1.9rem; height: 1.9rem; margin-left: 0.6rem; }
    nav a { font-size: var(--s-14); }
    .mark { font-size: 1.7rem; }
    .topbar.scrolled .mark { font-size: 1.45rem; }
  }
</style>
