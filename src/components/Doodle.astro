const a = art[name];
// Small marks don't boil; it reads as noise at that size.
const calm = still || name === 'star' || name === 'arrow';
---
{a && (
  <svg
    class={`doodle ${calm ? 'still' : ''} ${cls}`}
    viewBox={a.vb}
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    role={label ? 'img' : undefined}
    aria-label={label}
    aria-hidden={label ? undefined : 'true'}
    set:html={`<g class="ink">${a.d}</g>`}
  />
)}

<style is:global>
  .doodle { display: block; overflow: visible; }
  .doodle * { vector-effect: non-scaling-stroke; }
  .doodle .fill { fill: currentColor; }
  .doodle .thin { stroke-width: 0.9; opacity: 0.75; }
</style>
