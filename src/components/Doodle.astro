---
// Hand-drawn line art, all original. Stroke follows currentColor.
interface Props {
  name: string;
  class?: string;
  label?: string;
  still?: boolean;
}
const { name, class: cls = '', label, still = false } = Astro.props;

const art: Record<string, { vb: string; d: string }> = {
  peaks: {
    vb: '0 0 200 92',
