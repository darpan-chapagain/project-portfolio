        <path d="M39 43 L46 34 L54 42 L50 40 L46 44 L43 40 Z" class="fill"/>
        <path d="M127 35 L134 29 L141 37 L137 35 L134 39 L131 35 Z" class="fill"/>
        <path d="M92 28 L87 44 L80 60 M98 34 L101 52 M134 39 L131 55 M50 52 L47 66"/>
        <path d="M2 88 H198" />`,
  },
  biplane: {
    vb: '0 0 164 80',
    d: `<path d="M22 20 L142 16 L144 21 L24 25 Z"/>
        <path d="M26 44 L146 40 L148 45 L28 49 Z"/>
        <path d="M38 24 L40 47 M62 23 L64 46 M86 22 L88 45 M110 21 L112 44 M132 20 L134 43"/>
        <path d="M38 24 L64 46 M64 23 L40 47 M110 21 L134 43 M134 20 L112 44" class="thin"/>
        <path d="M2 31 L16 30 M2 36 L16 35 M16 32 L30 33"/>
        <path d="M150 24 L160 23 L160 41 L150 42 Z M144 32 L150 32"/>
        <ellipse cx="120" cy="32" rx="2" ry="9"/><ellipse cx="100" cy="33" rx="2" ry="9"/>
        <circle cx="88" cy="40" r="2.6" class="fill"/>
        <path d="M4 58 H30 M14 64 H44 M24 70 H52" class="thin"/>`,
  },
  stupa: {
    vb: '0 0 120 140',
    d: `<path d="M8 134 H112 M16 134 V126 H104 V134"/>
        <path d="M22 126 C22 94 98 94 98 126"/>
        <rect x="45" y="80" width="30" height="20"/>
        <path d="M49 89 Q54 84 59 89 Q54 91 49 89 Z M61 89 Q66 84 71 89 Q66 91 61 89 Z"/>
        <circle cx="54" cy="88.4" r="1.3" class="fill"/><circle cx="66" cy="88.4" r="1.3" class="fill"/>
        <path d="M60 92 q-3 3 0 5"/>
        <path d="M49 80 L53 44 H67 L71 80 M50 74 H70 M51 67 H69 M52 60 H68 M52 53 H68 M53 47 H67"/>
        <path d="M55 44 L60 31 L65 44"/>
        <circle cx="60" cy="27" r="3"/>
        <path d="M60 31 L4 112 M60 31 L116 112" class="thin"/>
        <path d="M22 81 l-5 -3 l2 7 Z M34 64 l-5 -3 l2 7 Z M98 81 l5 -3 l-2 7 Z M86 64 l5 -3 l-2 7 Z" class="fill"/>`,
  },
  book: {
    vb: '0 0 124 84',
    d: `<path d="M62 18 C47 8 22 8 6 14 V74 C22 68 47 68 62 78 C77 68 102 68 118 74 V14 C102 8 77 8 62 18 Z"/>
        <path d="M62 18 V78"/>
        <path d="M16 26 C28 22 42 22 52 26 M16 34 C28 30 42 30 52 34 M16 42 C28 38 42 38 52 42 M16 50 C26 46 36 46 44 49" class="thin"/>
        <path d="M72 26 C82 22 96 22 108 26 M72 34 C82 30 96 30 108 34 M72 42 C82 38 96 38 108 42" class="thin"/>
        <path d="M96 10 V30 L100 26 L104 30 V9" />`,
  },
  vault: {
    vb: '0 0 110 110',
    d: `<rect x="6" y="6" width="98" height="98" rx="6"/>
        <circle cx="55" cy="55" r="36"/>
        <circle cx="55" cy="55" r="9"/>
        <path d="M55 46 V24 M55 64 V86 M46 55 H24 M64 55 H86"/>
        <circle cx="55" cy="22" r="3.5" class="fill"/><circle cx="55" cy="88" r="3.5" class="fill"/>
        <circle cx="22" cy="55" r="3.5" class="fill"/><circle cx="88" cy="55" r="3.5" class="fill"/>
        <path d="M104 30 H98 M104 80 H98" />`,
  },
  dial: {
    vb: '0 0 100 100',
    d: `<circle cx="50" cy="50" r="42"/>
        <circle cx="50" cy="50" r="30"/>
        <circle cx="50" cy="50" r="10"/>
        <path d="M50 8 V15 M50 85 V92 M8 50 H15 M85 50 H92 M20 20 L25 25 M80 80 L75 75 M80 20 L75 25 M20 80 L25 75" />
        <path d="M50 20 L46 28 H54 Z" class="fill"/>
        <path d="M50 40 L50 30" />`,
  },
  laptop: {
    vb: '0 0 130 90',
    d: `<rect x="20" y="8" width="90" height="58" rx="4"/>
        <rect x="27" y="15" width="76" height="44"/>
        <path d="M6 76 L20 66 H110 L124 76 Z M6 76 V80 H124 V76"/>
        <path d="M56 80 V76 H74 V80" class="thin"/>
        <path d="M52 30 L42 37 L52 44 M78 30 L88 37 L78 44 M68 27 L62 47"/>`,
  },
  coins: {
    vb: '0 0 110 90',
    d: `<ellipse cx="40" cy="72" rx="30" ry="9"/><path d="M10 72 V62 M70 72 V62"/>
        <ellipse cx="40" cy="62" rx="30" ry="9"/><path d="M10 62 V52 M70 62 V52"/>
        <ellipse cx="40" cy="52" rx="30" ry="9"/><path d="M10 52 V42 M70 52 V42"/>
        <ellipse cx="40" cy="42" rx="30" ry="9"/>
        <circle cx="84" cy="30" r="20"/><circle cx="84" cy="30" r="14" class="thin"/>
        <path d="M74 37 L81 26 L85 31 L89 24 L95 37 Z" />`,
  },
  plane: {
    vb: '0 0 100 64',
    d: `<path d="M2 32 L98 4 L62 60 L47 40 Z"/>
        <path d="M47 40 L98 4 M47 40 L45 56 L55 47"/>`,
  },
  star: {
    vb: '0 0 20 20',
    d: `<path d="M10 0 Q11.4 8.6 20 10 Q11.4 11.4 10 20 Q8.6 11.4 0 10 Q8.6 8.6 10 0 Z" class="fill"/>`,
  },
  arrow: {
    vb: '0 0 90 40',
    d: `<path d="M3 30 C22 34 48 30 80 16"/><path d="M66 12 L81 15 L74 29"/>`,
  },
  lamp: {
    vb: '0 0 80 110',
    d: `<path d="M40 4 V18"/><path d="M22 40 L30 18 H50 L58 40 Z"/>
        <path d="M30 40 Q40 52 50 40" class="thin"/>
        <path d="M40 40 V94 M22 104 H58 L52 94 H28 Z"/>`,
  },
};

const a = art[name];
// Small marks don't boil; it reads as noise at that size.
const calm = still || name === 'star' || name === 'arrow';
---
{a && (
  <svg
    class={`doodle ${calm ? 'still' : ''} ${cls}`}
    viewBox={a.vb}
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    role={label ? 'img' : undefined}
    aria-label={label}
    aria-hidden={label ? undefined : 'true'}
    set:html={`<g class="ink">${a.d}</g>`}
  />
)}

<style is:global>
  .doodle { display: block; overflow: visible; }
  .doodle * { vector-effect: non-scaling-stroke; }
  .doodle .fill { fill: currentColor; }
  .doodle .thin { stroke-width: 0.9; opacity: 0.75; }
</style>
