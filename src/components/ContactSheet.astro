---
import type { CollectionEntry } from 'astro:content';
import Doodle from './Doodle.astro';
interface Props { items: CollectionEntry<'projects'>[]; label: string }
const { items, label } = Astro.props;
---
<ul class="sheet" aria-label={label}>
  {items.map((p) => (
    <li class="cell">
      <a class="print" href={`/work/${p.id}/`}>
        <Doodle name={p.data.art} class="print-art" />
        <span class="domain">{p.data.domain}</span>
        <span class="title display">{p.data.short}</span>
        {p.data.results[0] && <span class="result">{p.data.results[0]}</span>}
        <span class="role">{p.data.role}</span>
        <svg class="pick" viewBox="0 0 200 140" preserveAspectRatio="none" aria-hidden="true">
          <path d="M28 18 C80 2 160 4 186 30 C204 60 190 118 128 132 C70 142 14 126 8 84 C2 50 20 26 60 14" pathLength="1" />
        </svg>
      </a>
    </li>
  ))}
</ul>

<style>
  .sheet {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 0;
  }
  /* Each cell is a piece of film: dark base, sprocket holes top and bottom. */
  .cell {
    --hole: rgb(232 225 209 / 0.82);
    background: #0c0b09;
    padding: 22px 10px;
    position: relative;
  }
  .cell::before, .cell::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 8px;
    background: repeating-linear-gradient(90deg, transparent 0 7px, var(--hole) 7px 17px, transparent 17px 24px);
    border-radius: 2px;
    opacity: 0.55;
  }
  .cell::before { top: 7px; }
  .cell::after { bottom: 7px; }

  .print {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    gap: 0.5rem;
    min-height: 230px;
    height: 100%;
    padding: 1.1rem 1.1rem 1rem;
    background: var(--card);
    color: var(--card-ink);
    text-decoration: none;
    transition: transform 240ms var(--ease);
  }
  .domain { font-size: var(--s-14); color: #5b564c; padding-right: 56px; }
  .print :global(.print-art) { position: absolute; top: 0.9rem; right: 0.9rem; width: 44px; color: var(--card-ink); opacity: 0.85; transition: transform 400ms var(--ease); }
  .print:hover :global(.print-art) { transform: rotate(-8deg) scale(1.1); }
  .title { font-size: clamp(2.2rem, 3vw, 2.75rem); line-height: 0.92; align-self: start; padding-right: 44px; }
  .result { font-style: italic; font-size: var(--s-16); line-height: 1.4; }
  .role { font-size: var(--s-14); color: #5b564c; border-top: 1px solid rgb(var(--card-ink-rgb) / 0.18); padding-top: 0.5rem; }

  /* Grease-pencil circle, the way editors mark picks on a contact sheet. */
  .pick {
    position: absolute;
    inset: -6% -5%;
    width: 110%;
    height: 112%;
    pointer-events: none;
    fill: none;
    stroke: var(--postit);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0;
    transition: stroke-dashoffset 420ms var(--ease), opacity 120ms;
  }
  .print:hover .pick, .print:focus-visible .pick { stroke-dashoffset: 0; opacity: 1; }
  .print:hover, .print:focus-visible { transform: rotate(-0.8deg) scale(1.015); }
  .print:focus-visible { outline: none; }
  .cell:has(.print:hover), .cell:has(.print:focus-visible) { z-index: 2; }
</style>
