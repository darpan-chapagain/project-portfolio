---
import Doodle from './Doodle.astro';
import Flags from './Flags.astro';
import { person, heroFrames } from '../data/site';

// Stars scattered around the hero (percent of the hero box). Lines from the cursor reach these and the doodles.
const stars = [
  { x: 19, y: 24 }, { x: 28, y: 76 }, { x: 74, y: 14 }, { x: 68, y: 91 }, { x: 94, y: 50 }, { x: 4, y: 60 }, { x: 46, y: 18 },
];
const [first, last] = [person.first, person.last];
const [neFirst, neLast] = person.nepaliFull;
---
<section class="hero" aria-labelledby="hero-name" data-sky="0.34">
  <div class="hero-flags" data-speed="0.12">
    <div class="fl-d"><Flags /></div>
    <div class="fl-m"><Flags width={440} count={10} sag={22} /></div>
  </div>
  <canvas class="hub" aria-hidden="true"></canvas>

  <div class="d d-biplane" data-depth="0.9" data-speed="0.18"><Doodle name="biplane" /></div>
  <div class="d d-peaks" data-depth="0.35" data-speed="0.1"><Doodle name="peaks" /></div>
  <div class="d d-book" data-depth="0.7" data-speed="-0.06"><Doodle name="book" /></div>
  <div class="d d-dial" data-depth="1" data-speed="0.22"><Doodle name="dial" /></div>
  <div class="d d-plane" data-depth="1.2" data-speed="-0.1"><Doodle name="plane" /></div>
  {stars.map((s, i) => (
    <div class="d d-star" style={`left:${s.x}%;top:${s.y}%;--i:${i}`} data-depth={(0.4 + (i % 3) * 0.35).toFixed(2)}><Doodle name="star" /></div>
  ))}

  <div class="hero-inner wrap">
    <div class="reel-wrap paper-shadow" data-depth="0.25" data-speed="-0.05">
      <figure class="reel" aria-label="Snapshots from my story">
        {heroFrames.map((f, i) => (
          <div class:list={['frame torn', { 'is-on': i === 0 }]} data-frame={i}>
            <Doodle name={f.art} class="frame-art" />
            <figcaption class="hand">{f.caption}</figcaption>
          </div>
        ))}
      </figure>
    </div>

    <div class="intro" data-depth="0.12">
      <h1 id="hero-name" class="name" aria-label={person.name} title="Click to switch script">
        <span class="word" aria-hidden="true">
          <span class="face en display">{first}</span>
          <span class="face ne" lang="ne">{neFirst}</span>
        </span>
        <span class="word" aria-hidden="true">
          <span class="face en display">{last}</span>
          <span class="face ne" lang="ne">{neLast}</span>
        </span>
      </h1>
      <div class="entry">
        <p class="pron">
          <span class="syll">{person.syllables}</span>
          <span class="ipa">{person.ipa}</span>
          <em>noun</em>
        </p>
        <p class="say">say it: <span class="hand">{person.sayIt}</span></p>
        <ol>
          <li>A technical product manager with four years of shipping software, most recently banking systems that aren't allowed to fail.</li>
          <li>Now an M.S. Computer Science student at {person.school} in {person.location}, building on-device AI and the odd video game on the side.</li>
        </ol>
        <p class="note"><span class="lab">Usage:</span> the second syllable of Darpan rhymes with <em>sun</em>, not <em>pan</em>.</p>
        <details class="history">
          <summary class="note">
            <span class="lab">Origin:</span> Nepali <span class="ne-word" lang="ne">{person.nepali}</span>, a mirror.
            <span class="more hand">word history</span>
          </summary>
          <div class="history-body">
            <p>From Sanskrit <em>darpaṇa</em>, literally &ldquo;the thing that makes you proud&rdquo;, which is fair, since nobody walks past one without a look. I've taken it as a brief: do work I'd be proud to see reflected back, and make the big calls in my career and life the same way.</p>
            <p><span class="lab">See also:</span> <em>Lahana Le Jurayo Ki</em>, the title song of <em>Darpan Chhaya</em> (<span class="ne-word" lang="ne">दर्पण छायाँ</span>, 2001), written by Tulsi Ghimire, composed by Ranjit Gazmer and sung by Sadhana Sargam. The film became the biggest Nepali movie of its time, and the song's refrain compares a whole life to a reflection in a mirror. A reflection is only as clear as the glass. Most of my work is cleaning the glass: clean data, clear specs, no surprises.</p>
          </div>
        </details>
      </div>
    </div>
  </div>

  <a class="scroll-cue hand" href="#play">scroll, or press play below</a>
</section>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  // Swap the snapshot in the torn frame, like cuts in a reel.
  const frames = Array.from(document.querySelectorAll<HTMLElement>('.reel .frame'));
  let i = 0;
  let timer: number | undefined;
  const tilt = [-4, 2.5, -1.5, 3.5, -3];
  const step = () => {
    frames[i].classList.remove('is-on');
    i = (i + 1) % frames.length;
    frames[i].style.setProperty('--tilt', `${tilt[i % tilt.length]}deg`);
    frames[i].classList.add('is-on');
  };
  const start = () => { if (!reduce.matches && frames.length > 1) timer = window.setInterval(step, 2600); };
  const stop = () => window.clearInterval(timer);
  const reel = document.querySelector('.reel');
  reel?.addEventListener('mouseenter', stop);
  reel?.addEventListener('mouseleave', start);
  start();

  // Turn the name over like a sheet of paper: English on one side, Nepali on the other.
  const name = document.querySelector<HTMLElement>('.hero .name');
  const words = Array.from(name?.querySelectorAll<HTMLElement>('.word') ?? []);
  let angle = 0;
  let flipTimer: number | undefined;
  const flip = () => {
    angle -= 180;
    words.forEach((w, k) => {
      w.style.transitionDelay = `${k * 140}ms`;
      w.style.animationDelay = `${k * 140}ms`;
      w.classList.remove('flipping');
      void w.offsetWidth;
      w.classList.add('flipping');
      w.style.setProperty('--angle', `${angle}deg`);
    });
  };
  const auto = () => { if (!reduce.matches) flipTimer = window.setInterval(flip, 4200); };
  name?.addEventListener('click', () => { window.clearInterval(flipTimer); flip(); auto(); });
  window.setTimeout(() => { if (!reduce.matches) { flip(); auto(); } }, 2600);

  document.querySelector('.hero .history')?.addEventListener('toggle', () => window.dispatchEvent(new Event('resize')));

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) { stop(); window.clearInterval(flipTimer); }
    else { start(); auto(); }
  });
</script>

<style>
  .hero {
    position: relative;
    min-height: max(100svh, 720px);
    display: grid;
    place-items: center;
    padding-block: 9rem 5rem;
    overflow: hidden;
    color: var(--chalk);
  }
  .hero-flags {
    position: absolute;
    top: 60px;
    left: -2%;
    width: 104%;
    opacity: 0.55;
    animation: fade 1.6s var(--ease) both;
  }
  .fl-m { display: none; }
  .hub { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; animation: fade 1.4s ease 0.6s both; }

  .d { position: absolute; color: var(--chalk); animation: arrive 1.2s var(--ease) both; will-change: translate; }
  .d > :global(svg) { width: 100%; height: auto; animation: drift 9s ease-in-out infinite alternate; }
  .d-biplane { top: 27%; right: 4%; width: clamp(140px, 16vw, 230px); animation-delay: 200ms; }
  .d-biplane > :global(svg) { animation-duration: 7s; }
  .d-peaks { bottom: 6%; left: 2%; width: clamp(200px, 26vw, 360px); animation-delay: 100ms; }
  .d-peaks > :global(svg) { animation: none; }
  .d-book { bottom: 11%; right: 7%; width: clamp(90px, 10vw, 150px); animation-delay: 350ms; }
  .d-dial { top: 31%; left: 5%; width: clamp(54px, 6vw, 84px); animation-delay: 450ms; }
  .d-plane { top: 52%; right: 2.5%; width: clamp(50px, 5vw, 76px); animation-delay: 550ms; }
  .d-star { width: 12px; margin: -6px 0 0 -6px; animation-delay: calc(500ms + var(--i) * 80ms); }
  .d-star > :global(svg) { animation: twinkle 3.5s ease-in-out infinite alternate; animation-delay: calc(var(--i) * -0.6s); }

  .hero-inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(220px, 300px) minmax(0, 640px);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    justify-content: center;
  }

  .reel-wrap { will-change: translate; }
  .reel {
    margin: 0;
    position: relative;
    aspect-ratio: 5 / 6;
    animation: arrive 1s var(--ease) 250ms both;
  }
  .frame {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: 1fr auto;
    padding: 1.6rem 1.4rem 1.2rem;
    visibility: hidden;
    transform: rotate(var(--tilt, -4deg));
  }
  .frame.is-on { visibility: visible; animation: cut 260ms steps(2, end), var(--boil); }
  .frame:not(.is-on) :global(.ink) { animation: none; filter: none; }
  .frame :global(.frame-art) { width: 72%; height: 100%; max-height: 220px; margin: auto; color: var(--card-ink); }
  .frame figcaption { font-size: var(--s-21); line-height: 1.25; color: var(--card-ink); }

  /* The name, printed on both sides of the sheet. */
  .name {
    font-size: clamp(4.75rem, 12vw, 10.5rem);
    color: var(--paper);
    display: flex;
    flex-direction: column;
    perspective: 1100px;
    cursor: pointer;
    user-select: none;
    animation: echo 1300ms var(--ease) 150ms both;
  }
  .word {
    display: grid;
    justify-items: start;
    transform-style: preserve-3d;
    transform: rotateX(var(--angle, 0deg));
    transform-origin: 50% 55%;
    transition: transform 1.05s cubic-bezier(0.62, -0.28, 0.32, 1.32);
  }
  .face {
    grid-area: 1 / 1;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    line-height: 0.86;
  }
  .face.ne {
    transform: rotateX(180deg);
    font-family: var(--deva);
    font-weight: 600;
    font-size: 0.98em;
    line-height: 0.8;
    padding-top: 0.08em;
  }
  /* Mid-turn the sheet bows and catches the light, like paper does. */
  .word.flipping { animation: paper-turn 1.05s cubic-bezier(0.62, -0.28, 0.32, 1.32) both; }
  .word.flipping .face { animation: paper-light 1.05s ease both; animation-delay: inherit; }
  @keyframes paper-turn {
    0% { scale: 1; }
    45% { scale: 1.04 0.96; }
    100% { scale: 1; }
  }
  @keyframes paper-light {
    0%, 100% { text-shadow: 0 0 0 transparent; }
    45% { text-shadow: 0 0.12em 0.08em var(--shadow-soft); }
  }

  .entry {
    margin-top: 1.4rem;
    max-width: 52ch;
    color: var(--paper);
    animation: fade 1.2s var(--ease) 700ms both;
  }
  .pron {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.9rem;
    font-size: var(--s-16);
    color: var(--paper-dim);
  }
  .syll { color: var(--paper); font-weight: 600; letter-spacing: 0.01em; }
  .ipa { font-family: var(--ipa); font-size: 1.04em; letter-spacing: 0.01em; }
  .say {
    margin: 0.2rem 0 0.7rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid rgb(var(--chalk-rgb) / 0.3);
    font-size: var(--s-16);
    color: var(--paper-dim);
  }
  .say .hand { color: var(--paper); font-size: 1.12em; margin-left: 0.2rem; }
  .entry ol { margin: 0; padding-left: 1.3rem; font-size: var(--s-18); }
  .entry li + li { margin-top: 0.4rem; }
  .entry li::marker { color: var(--paper-dim); font-size: var(--s-16); }
  .note { margin: 0.8rem 0 0; color: var(--paper-dim); font-size: var(--s-16); }
  .note em { color: var(--paper); }
  .lab { font-style: italic; color: var(--paper); margin-right: 0.15rem; }
  .ne-word { font-family: var(--hand); font-size: 1.15em; color: var(--paper); }

  .history summary {
    list-style: none;
    cursor: pointer;
    margin-top: 0.35rem;
  }
  .history summary::-webkit-details-marker { display: none; }
  .more {
    display: inline-block;
    margin-left: 0.5rem;
    color: var(--paper);
    font-size: 1.05em;
    border-bottom: 1px dashed var(--chalk-2);
    line-height: 1.2;
  }
  .more::after { content: ' +'; }
  .history[open] .more::after { content: ' \2212'; }
  .history summary:hover .more { border-bottom-color: var(--paper); }
  .history-body {
    margin-top: 0.7rem;
    padding: 0.2rem 0 0.2rem 1rem;
    border-left: 1px solid rgb(var(--chalk-rgb) / 0.35);
    font-size: var(--s-16);
    color: var(--chalk);
    max-width: 50ch;
  }
  .history-body p { margin: 0 0 0.7rem; }
  .history-body p:last-child { margin-bottom: 0; }
  .history[open] .history-body { animation: unfold 520ms var(--ease) both; }
  @keyframes unfold { from { opacity: 0; transform: translateY(-6px); clip-path: inset(0 0 100% 0); } to { opacity: 1; transform: none; clip-path: inset(0 0 0 0); } }

  .scroll-cue {
    position: absolute;
    bottom: 1.6rem;
    left: 50%;
    translate: -50% 0;
    font-size: var(--s-18);
    color: var(--paper-dim);
    text-decoration: none;
    z-index: 3;
    animation: fade 1s ease 1.6s both;
  }

  @keyframes fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes arrive { from { opacity: 0; transform: translateY(14px) scale(0.97); } to { opacity: 1; transform: none; } }
  @keyframes drift { from { transform: translateY(-5px) rotate(-1deg); } to { transform: translateY(6px) rotate(1deg); } }
  @keyframes twinkle { from { opacity: 0.35; transform: scale(0.7); } to { opacity: 1; transform: scale(1.15); } }
  @keyframes cut {
    0% { opacity: 0.2; transform: rotate(var(--tilt, -4deg)) translate(4px, -3px); }
    100% { opacity: 1; transform: rotate(var(--tilt, -4deg)); }
  }

  @media (max-width: 860px) {
    .hero { padding-block: 8.5rem 6rem; place-items: start center; }
    .hero-inner { grid-template-columns: 1fr; justify-items: start; gap: 2.5rem; }
    .intro { order: -1; }
    .reel-wrap { width: min(260px, 70vw); justify-self: center; }
    .d-dial, .d-plane, .d-book, .d-biplane, .d-star, .fl-d { display: none; }
    .fl-m { display: block; }
    .hero-flags { top: 66px; }
    .d-peaks { bottom: 3%; width: 240px; opacity: 0.6; }
    .hub { display: none; }
    .scroll-cue { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .word { transition: none; }
  }
</style>
