---
// Awards, talks and community work as ticket stubs. Lives on the Work page.
import { recognition } from '../data/site';
---
<ul class="stubs" data-reveal>
  {recognition.map((r, i) => (
    <li class="stub-wrap paper-shadow" style={`--i:${i};--r:${[-1.2, 0.9, 1.1, -0.8][i % 4]}deg`}>
      <div class="stub">
        <span class="year display">{r.year}</span>
        <span class="stub-body">
          <span class="stub-title">{r.title}</span>
          <span class="stub-where">{r.where}</span>
          <span class="stub-note">{r.note}</span>
          {r.link && <a class="stub-link hand" href={r.link}>see the talk</a>}
        </span>
      </div>
    </li>
  ))}
</ul>

<style>
  .stubs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.8rem 2.2rem; }
  .stub-wrap { transform: rotate(var(--r)); transition: transform 350ms var(--ease); }
  .stub-wrap:hover { transform: rotate(calc(var(--r) * -0.5)) translateY(-4px); }
  .js .stubs:not(.is-in) .stub-wrap { opacity: 0; }
  .stubs.is-in .stub-wrap { animation: deal 800ms cubic-bezier(0.25, 1.3, 0.5, 1) backwards; animation-delay: calc(var(--i) * 130ms); }
  @keyframes deal { from { opacity: 0; transform: translateX(-40px) rotate(calc(var(--r) - 6deg)); } to { opacity: 1; transform: rotate(var(--r)); } }
  .stub {
    display: grid;
    grid-template-columns: 6.2rem 1fr;
    background: var(--card);
    color: var(--card-ink);
    min-height: 9rem;
    -webkit-mask: radial-gradient(circle at 0 50%, transparent 11px, #000 11.5px) left / 51% 100% no-repeat, radial-gradient(circle at 100% 50%, transparent 11px, #000 11.5px) right / 51% 100% no-repeat;
    mask: radial-gradient(circle at 0 50%, transparent 11px, #000 11.5px) left / 51% 100% no-repeat, radial-gradient(circle at 100% 50%, transparent 11px, #000 11.5px) right / 51% 100% no-repeat;
  }
  .year {
    display: grid;
    place-items: center;
    font-size: 2.6rem;
    border-right: 2px dashed rgb(var(--card-ink-rgb) / 0.25);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }
  .stub-body { display: grid; align-content: center; gap: 0.15rem; padding: 1.1rem 1.6rem 1.1rem 1.3rem; }
  .stub-title { font-family: var(--display); text-transform: uppercase; font-size: 1.9rem; line-height: 1; }
  .stub-where { font-size: var(--s-14); color: rgb(var(--card-ink-rgb) / 0.7); }
  .stub-note { font-size: var(--s-16); line-height: 1.45; margin-top: 0.35rem; }
  .stub-link { justify-self: start; margin-top: 0.3rem; font-size: var(--s-18); color: var(--card-ink); }
  @media (max-width: 760px) { .stubs { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) {
    .js .stubs:not(.is-in) .stub-wrap { opacity: 1; }
  }
</style>
