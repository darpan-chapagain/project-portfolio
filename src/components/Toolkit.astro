---
// The toolkit as a wall of sticky notes. Lives on the How I build page.
import { toolkit } from '../data/site';
---
<ul class="notes-wall" data-reveal>
  {toolkit.map((t, i) => (
    <li class="postit hand" style={`--r:${[-3, 2, -1.5, 3, -2.5, 1.5, 2.5, -2][i % 8]}deg;--i:${i}`} data-speed={[0.03, -0.02, 0.05, -0.04, 0.02, -0.03, 0.04, -0.02][i % 8]}>
      <strong>{t.heading}</strong>
      <span>{t.items}</span>
    </li>
  ))}
</ul>

<style>
  .notes-wall { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.8rem 2rem; }
  @media (max-width: 1000px) { .notes-wall { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .notes-wall { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.2rem; } }
  .js .notes-wall:not(.is-in) .postit { opacity: 0; }
  .notes-wall.is-in .postit { animation: stick 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) backwards; animation-delay: calc(var(--i) * 90ms); }
  @keyframes stick {
    0% { opacity: 0; transform: rotate(calc(var(--r, -2deg) * 3)) translateY(-24px) scale(1.12); box-shadow: 0 40px 30px -16px rgb(0 0 0 / 0.5); }
    100% { opacity: 1; transform: rotate(var(--r, -2deg)); }
  }
  .postit strong { display: block; font-weight: 700; font-size: var(--s-21); margin-bottom: 0.3rem; }
  @media (prefers-reduced-motion: reduce) {
    .js .notes-wall:not(.is-in) .postit { opacity: 1; }
  }
</style>
