---
import Doodle from './Doodle.astro';

const R = 150;
const C = 2 * Math.PI * R;
const phrase = 'PLAY MY JOURNEY ✦ PLAY MY JOURNEY ✦';

// 8-bit peaks for the button face: each string is a row, # is a filled pixel.
const pixels = [
  '......#.........',
  '.....###........',
  '....#####...#...',
  '...#######.###..',
  '..###########...',
  '.#############..',
  '################',
];
---
<section id="play" class="play" aria-labelledby="play-title">
  <h2 id="play-title" class="sr-only">Play my journey</h2>

  <div class="stage">
    <span class="cue cue-l hand" aria-hidden="true" data-depth="0.5">click to play <Doodle name="arrow" class="cue-arrow" /></span>

    <a class="ring-link" href="/journey/" data-countdown aria-label="Play my journey" data-speed="0.06" data-depth="0.15">
      <svg class="ring echo-ring" viewBox="-222 -222 444 444" aria-hidden="true">
        <defs>
          <path id="ring-path" d={`M 0 ${-R} A ${R} ${R} 0 1 1 -0.01 ${-R} Z`} />
        </defs>
        <g class="spin">
          <text class="ring-text">
            <textPath href="#ring-path" textLength={C.toFixed(1)} lengthAdjust="spacing">{phrase}</textPath>
          </text>
        </g>
        <circle r="112" class="ring-line" />
        <g class="face">
          <circle r="96" class="face-disc" />
          <g transform="translate(-64 6)">
            {pixels.map((row, y) => [...row].map((c, x) => c === '#' && <rect x={x * 8} y={y * 8} width="8" height="8" />))}
          </g>
          <path class="play-tri" d="M-18 -58 L26 -32 L-18 -6 Z" />
        </g>
      </svg>
    </a>

    <span class="cue cue-r hand" aria-hidden="true" data-depth="0.5"><Doodle name="arrow" class="cue-arrow flip" /> click to play</span>
  </div>

  <p class="blurb">From a classroom in Kathmandu to Wright State University in Ohio, one level at a time. A playable version is in the works.</p>

  <div class="leader" hidden aria-hidden="true">
    <svg viewBox="-200 -200 400 400">
      <circle r="180" class="l-ring" />
      <circle r="140" class="l-ring" />
      <path d="M-200 0 H200 M0 -200 V200" class="l-cross" />
      <text class="l-num" y="62" text-anchor="middle">3</text>
    </svg>
    <div class="sweep"></div>
  </div>
</section>

<script>
  const link = document.querySelector<HTMLAnchorElement>('[data-countdown]');
  const leader = document.querySelector<HTMLElement>('.leader');
  const num = leader?.querySelector('.l-num');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  link?.addEventListener('click', (e) => {
    if (reduce.matches || !leader || !num || e.metaKey || e.ctrlKey) return;
    e.preventDefault();
    leader.hidden = false;
    document.body.style.overflow = 'hidden';
    let n = 3;
    num.textContent = String(n);
    const tick = window.setInterval(() => {
      n -= 1;
      if (n === 0) {
        window.clearInterval(tick);
        window.location.href = link.href;
        return;
      }
      num.textContent = String(n);
      leader.classList.remove('beat');
      void leader.offsetWidth;
      leader.classList.add('beat');
    }, 700);
  });

  // Coming back with the back button should not leave the countdown on screen.
  window.addEventListener('pageshow', () => {
    if (leader) { leader.hidden = true; document.body.style.overflow = ''; }
  });
</script>

<style>
  .play {
    position: relative;
    padding-block: clamp(4rem, 10vw, 7rem) clamp(4rem, 8vw, 6rem);
    display: grid;
    justify-items: center;
    gap: 1.5rem;
    border-block: 1px solid rgb(214 207 191 / 0.14);
    background:
      radial-gradient(circle at 50% 45%, rgb(232 225 209 / 0.05), transparent 55%),
      var(--ink);
  }
  .stage {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: min(1100px, 100%);
    padding-inline: var(--gutter);
  }
  .ring-link { display: block; width: clamp(300px, 46vw, 520px); border-radius: 50%; }
  .ring { width: 100%; height: auto; overflow: visible; color: var(--paper); }
  .ring-text { font-family: var(--display); font-size: 64px; fill: var(--paper); }
  .spin { transform-origin: 0 0; animation: spin 40s linear infinite; }
  .ring-line { fill: none; stroke: var(--chalk-2); stroke-width: 1; stroke-dasharray: 2 6; }
  .face { transition: transform 300ms var(--ease); transform-origin: 0 0; }
  .face-disc { fill: var(--paper); }
  .face rect { fill: var(--ink); }
  .play-tri { fill: var(--ink); stroke: var(--ink); stroke-width: 6; stroke-linejoin: round; }
  .ring-link:hover .face, .ring-link:focus-visible .face { transform: scale(1.06); }
  .ring-link:hover .spin { animation-duration: 12s; }
  .ring-link:focus-visible { outline-offset: 10px; }

  .cue { font-size: clamp(var(--s-18), 2vw, var(--s-24)); color: var(--paper); display: flex; align-items: center; gap: 0.6rem; }
  .cue-l { justify-self: end; margin-right: 1rem; }
  .cue-r { justify-self: start; margin-left: 1rem; }
  .cue :global(.cue-arrow) { width: 70px; color: var(--paper); }
  .cue :global(.cue-arrow.flip) { transform: scaleX(-1); }

  .blurb { margin: 0; max-width: 46ch; text-align: center; color: var(--paper-dim); font-size: var(--s-16); padding-inline: var(--gutter); }

  /* Echo on the ring as it scrolls in. */
  .js .echo-ring { opacity: 0; }
  .echo-ring.is-in { animation: ring-in 1200ms var(--ease) both; }
  @keyframes ring-in {
    0% { opacity: 0; transform: scale(0.88); filter: drop-shadow(0 -14px 0 rgb(232 225 209 / 0.35)) drop-shadow(0 -28px 0 rgb(232 225 209 / 0.2)) drop-shadow(0 -42px 0 rgb(232 225 209 / 0.1)); }
    30% { opacity: 1; }
    100% { opacity: 1; transform: none; filter: drop-shadow(0 0 0 rgb(232 225 209 / 0)) drop-shadow(0 0 0 rgb(232 225 209 / 0)) drop-shadow(0 0 0 rgb(232 225 209 / 0)); }
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* Film leader countdown. */
  .leader {
    position: fixed;
    inset: 0;
    z-index: 150;
    display: grid;
    place-items: center;
    background: #cfc8b8;
    color: var(--ink);
  }
  .leader[hidden] { display: none; }
  .leader svg { width: min(90vmin, 640px); position: relative; z-index: 2; }
  .l-ring { fill: none; stroke: var(--ink); stroke-width: 3; }
  .l-cross { stroke: var(--ink); stroke-width: 2; }
  .l-num { font-family: var(--display); font-size: 190px; fill: var(--ink); }
  .sweep {
    position: absolute;
    width: calc(min(90vmin, 640px) * 0.9);
    aspect-ratio: 1;
    border-radius: 50%;
    background: conic-gradient(rgb(21 19 15 / 0.35) 0deg, rgb(21 19 15 / 0.35) var(--a, 0deg), transparent var(--a, 0deg));
    animation: sweep 700ms linear infinite;
    z-index: 1;
  }
  @property --a { syntax: '<angle>'; inherits: false; initial-value: 0deg; }
  @keyframes sweep { from { --a: 0deg; } to { --a: 360deg; } }
  .leader.beat svg { animation: jolt 140ms steps(2) 1; }
  @keyframes jolt { 50% { transform: translate(3px, -2px); } }

  @media (max-width: 760px) {
    .stage { grid-template-columns: 1fr; justify-items: center; gap: 0.5rem; }
    .cue-l { justify-self: center; margin: 0; order: -1; }
    .cue-l :global(.cue-arrow) { transform: rotate(70deg); width: 46px; }
    .cue-r { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .spin { animation: none; }
    .js .echo-ring { opacity: 1; }
  }
</style>
